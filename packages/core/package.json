{
  "name": "@agora/core",
  "version": "0.16.3",
  "private": true,
  "type": "module",
  "description": "Shared Agora server kernel — env, logger, db client + schema, http envelope/context, auth/project middleware, validation, suspensions, redis. Consumed by @agora/api and @agora/secure-chat.",
  "license": "AGPL-3.0-only",
  "exports": {
    "./db": {
      "types": "./dist/db/index.d.ts",
      "import": "./dist/db/index.js"
    },
    "./db/schema": {
      "types": "./dist/db/schema/index.d.ts",
      "import": "./dist/db/schema/index.js"
    },
    "./*": {
      "types": "./dist/*.d.ts",
      "import": "./dist/*.js"
    }
  },
  "files": [
    "dist",
    "wonder-logger.yaml"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsc -w -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@agora-server/contract": "workspace:*",
    "@jenova-marie/wonder-logger": "^2.1.0",
    "drizzle-orm": "^0.45.2",
    "hono": "^4.12.23",
    "ioredis": "^5.11.1",
    "jose": "^5.10.0",
    "postgres": "^3.4.9",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^22.19.20",
    "typescript": "^5.9.3",
    "vitest": "^4.1.8"
  }
}
