{
  "name": "@agora/contract",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Shared Agora API contract — response-model types + zod request schemas (no hono/drizzle).",
  "license": "Apache-2.0",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
