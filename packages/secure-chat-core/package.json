{
  "name": "@agora/secure-chat-core",
  "version": "0.9.0",
  "private": true,
  "type": "module",
  "description": "Secure-chat client crypto seam — the SecureChatCrypto interface + a deterministic mock impl. The concrete MLS core (ts-mls / OpenMLS-WASM) plugs in behind this. The server depends on NONE of it.",
  "license": "AGPL-3.0-only",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsc -w -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@agora/contract": "workspace:*"
  },
  "devDependencies": {
    "typescript": "^5.7.2",
    "vitest": "^4.1.7"
  }
}
