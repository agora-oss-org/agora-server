# Single public front door for Agora (docker-compose `proxy` service, part of `--profile full`).
# Caddy provisions + auto-renews Let's Encrypt certs for a real SERVER_NAME (internal CA for
# `localhost`/IPs, so local dev gets HTTPS with no setup), terminates TLS, serves the admin SPA, AND
# routes every service itself — there is no longer a separate admin nginx. The full routing + the SPA
# static server live in the shared (agora-site) snippet (deploy/proxy/agora-routes.caddy). Caddy
# substitutes {$ENV:default} placeholders itself — no envsubst.
#
# ONE proxy hop now (just Caddy), so set RATE_LIMIT_TRUSTED_HOPS=1 in .env.
#
# Plain-HTTP / behind-an-external-TLS-terminator: set SERVER_NAME=:80 so Caddy serves HTTP only and
# skips ACME (replaces the old bare-nginx-on-8080 mode).
{
	# ACME account email for Let's Encrypt expiry notices (optional; certs issue fine without it).
	# Uncomment + set, or add `email you@example.com` here:
	# email {$ACME_EMAIL}
}

# Loads the (agora-site) snippet so the site block below can `import agora-site`. NOTE: this file MUST
# be mounted into the container alongside the Caddyfile (see docker-compose.yml) — `import` resolves
# relative to /etc/caddy, so the snippet lands at /etc/caddy/agora-routes.caddy.
import agora-routes.caddy

# Site address drives certificate issuance: a real domain → public Let's Encrypt; localhost/IP →
# Caddy's internal CA (trust it with `caddy trust`, or use `curl -k`); `:80` → plain HTTP, no ACME.
{$SERVER_NAME:localhost} {
	import agora-site
}
