# Bundled TLS-terminating edge proxy for Agora (docker-compose `proxy` service, `--profile edge`).
# Caddy provisions + auto-renews Let's Encrypt certs for a real SERVER_NAME (and uses its own internal CA
# for `localhost`/IPs, so local dev gets HTTPS with no setup). It's the single public front door: TLS,
# security headers, a request-body cap, and an authoritative X-Forwarded-For, reverse-proxying to the
# admin nginx (which serves the SPA + routes /v7, /socket.io, /moderator). Caddy substitutes {$ENV:default}
# placeholders itself — no envsubst.
#
# Behind this edge, set RATE_LIMIT_TRUSTED_HOPS=2 in .env (caddy + admin are the two trusted proxies).
{
	# ACME account email for Let's Encrypt expiry notices (optional; certs issue fine without it).
	# Uncomment + set, or add `email you@example.com` here:
	# email {$ACME_EMAIL}
}

# Site address drives certificate issuance: a real domain → public Let's Encrypt; localhost/IP → Caddy's
# internal CA (trust it with `caddy trust`, or use `curl -k`, for local testing).
{$SERVER_NAME:localhost} {
	encode gzip

	# Cap request bodies (uploads / JSON) at the edge — bounds storage abuse + sharp OOM before the app.
	request_body {
		max_size {$MAX_BODY_SIZE:25MB}
	}

	# Security headers (HSTS only meaningfully applies once served over real HTTPS).
	header {
		Strict-Transport-Security "max-age=63072000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		X-Frame-Options "SAMEORIGIN"
		-Server
		# A strict CSP is SPA-specific — enable + tune for your build, e.g.:
		# Content-Security-Policy "default-src 'self'; img-src 'self' data: https:; connect-src 'self' https: wss:"
	}

	# Everything goes to the admin nginx (SPA + /v7 + /socket.io + /moderator). WebSocket upgrades are
	# handled automatically. Caddy sets X-Forwarded-For to the REAL client by default and — with no
	# `trusted_proxies` configured — ignores any client-supplied X-Forwarded-For, so it can't be spoofed
	# to poison rate limiting downstream. The admin then appends its hop; the app reads
	# RATE_LIMIT_TRUSTED_HOPS=2 from the right.
	reverse_proxy {$ADMIN_UPSTREAM:http://admin:80}
}
