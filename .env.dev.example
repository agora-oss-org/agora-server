# ──────────────────────────────────────────────────────────────────────────────
# Agora — DEV config, pairs with docker-compose.dev.yml (host-run apps + HMR).
# You run the app surfaces on the HOST (`pnpm --filter @agora/api dev`, etc.); the containers (Caddy
# front door, cron, scorer, and the backing db/minio/neo4j/redis) run via the dev compose and are
# PUBLISHED to localhost so the host processes reach them there.
#
# Agora is LOCAL-POSTGRES-FIRST: this template is configured for a local Postgres + MinIO out of the box
# — NO cloud account needed. Cloud Supabase is an in-file switch (see the DATA PLANE block below).
#
# 1. cp .env.dev.example .env    (also `cd apps/api && cp ../../.env.dev.example .env` — the host API
#    reads apps/api/.env; see README → Environment files)    2. fill every <GENERATE: …> placeholder
#
# ── Bring it up — local Postgres (the default) ────────────────────────────────
#     docker compose -f docker-compose.dev.yml --profile selfhost up --build   # backing svcs + front door
#     cd apps/api && pnpm db:migrate:run && pnpm dev                            # host API → :4000
#   Admin SPA (host vite): DEV_HOST=true pnpm --filter @agora/admin dev · front door: http://localhost
# ── Or cloud Supabase ─────────────────────────────────────────────────────────
#   Switch the DATA PLANE block below, then use `--profile supabase` (no db/minio containers).
#
# Secret rules: passwords inside a URL / NEO4J_AUTH must avoid / @ : → openssl rand -hex 16 ·
#               token secrets are standalone (≥32 chars) → openssl rand -base64 48
# ──────────────────────────────────────────────────────────────────────────────
AGORA_ENV=dev

# ═══ Core ═════════════════════════════════════════════════════════════════════
ACCESS_TOKEN_SECRET=<GENERATE: openssl rand -base64 48>
PORT=4000
RATE_LIMIT_TRUSTED_HOPS=1
OPERATOR_EMAILS=agora-admin@gmail.com

# ═══ DATA PLANE — local Postgres + MinIO (DEFAULT) ════════════════════════════
# The app runs on the HOST, so it reaches the dev compose's PUBLISHED containers at localhost. The
# scorer WORKER container can't use localhost (that's itself inside a container), so it reads
# DEV_DATABASE_URL at the in-network db address instead. The URL password MUST equal POSTGRES_PASSWORD.
DATABASE_URL=postgres://postgres:<POSTGRES_PASSWORD>@localhost:5432/postgres
DEV_DATABASE_URL=postgres://postgres:<POSTGRES_PASSWORD>@db:5432/postgres
STORAGE_PROVIDER=s3
S3_ENDPOINT=http://localhost:9000
S3_PUBLIC_URL=http://localhost/media
S3_ACCESS_KEY_ID=agora
S3_SECRET_ACCESS_KEY=<MINIO_ROOT_PASSWORD>
S3_BUCKET=agora
S3_REGION=us-east-1
S3_FORCE_PATH_STYLE=true
DEFAULT_AUTH_PROVIDER=native
POSTGRES_PASSWORD=<GENERATE: openssl rand -hex 16>
MINIO_ROOT_USER=agora
MINIO_ROOT_PASSWORD=<GENERATE: openssl rand -hex 16>
#
# ── OR cloud Supabase ─────────────────────────────────────────────────────────
# Comment the LOCAL block above (DATABASE_URL … MINIO_ROOT_PASSWORD; drop DEV_DATABASE_URL too — the
# cloud URL works from both host and container), uncomment these, and run `--profile supabase`:
#DATABASE_URL=postgresql://postgres.<PROJECT_REF>:<DB_PASSWORD>@aws-1-<region>.pooler.supabase.com:6543/postgres
#SUPABASE_URL=https://<PROJECT_REF>.supabase.co
#SUPABASE_ANON_KEY=<Supabase → Settings → API → anon / publishable>
#SUPABASE_SERVICE_ROLE_KEY=<Supabase → Settings → API → service_role (secret)>
#DEFAULT_AUTH_PROVIDER=supabase

# ═══ Front door (Caddy) ═══════════════════════════════════════════════════════
SERVER_NAME=:80
PUBLIC_BASE_URL=http://localhost
# The host API also reads this directly (moderation write-back target); on the host that's localhost.
API_BASE_URL=http://localhost:4000

# ═══ Backing services — HOST-side hostnames (the app runs on the host) ════════
# The dev compose publishes these to localhost; it overrides the container-side consumers (scorer/cron)
# to service names automatically. Only needed if you add --profile scorer / --profile secure-chat.
NEO4J_URI=bolt://localhost:7687
NEO4J_AUTH=neo4j/<GENERATE: openssl rand -hex 16>
NEO4J_ACCEPT_LICENSE_AGREEMENT=yes
REDIS_URL=redis://localhost:6379

# ═══ Internal endpoints (cron + scorer write-back) ════════════════════════════
CRON_SECRET=<GENERATE: openssl rand -base64 48>
MODERATION_SERVICE_SECRET=<GENERATE: openssl rand -base64 48>

# ═══ Optional AI features (blank = disabled) ══════════════════════════════════
ANTHROPIC_API_KEY=
VOYAGE_API_KEY=

# ═══ Observability (off by default) ═══════════════════════════════════════════
LOG_LEVEL=debug
LOG_CONSOLE=aligned
OTEL_SDK_DISABLED=true
