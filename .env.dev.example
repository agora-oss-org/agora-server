# ──────────────────────────────────────────────────────────────────────────────
# Agora — DEV config, pairs with docker-compose.dev.yml (host-run apps + HMR).
# You run the app surfaces on the HOST (`pnpm --filter @agora/api dev`, etc.); the containers (Caddy
# front door, cron, scorer, and the backing db/minio/neo4j/redis) run via the dev compose and are
# PUBLISHED to localhost so the host processes reach them there.
#
# Agora is LOCAL-POSTGRES-FIRST: this template is configured for a local Postgres + MinIO out of the box
# — NO cloud account needed. Cloud Supabase is an in-file switch (see the DATA PLANE block below).
#
# 1. cp .env.dev.example .env    (also `cd apps/api && cp ../../.env.dev.example .env` — the host API
#    reads apps/api/.env; see README → Environment files)    2. fill every <GENERATE: …> placeholder
#
# ── Bring it up — local Postgres (the default) ────────────────────────────────
#     docker compose -f docker-compose.dev.yml --profile selfhost up --build   # backing svcs + front door
#     cd apps/api && pnpm db:migrate:run && pnpm dev                            # host API → :4000
#   Admin SPA (host vite): DEV_HOST=true pnpm --filter @agora/admin dev · front door: http://localhost
# ── Or cloud Supabase ─────────────────────────────────────────────────────────
#   Switch the DATA PLANE block below, then use `--profile supabase` (no db/minio containers).
#
# Secret rules: passwords inside a URL / NEO4J_AUTH must avoid / @ : → openssl rand -hex 16 ·
#               token secrets are standalone (≥32 chars) → openssl rand -base64 48
# ──────────────────────────────────────────────────────────────────────────────
AGORA_ENV=dev

# ═══ Core ═════════════════════════════════════════════════════════════════════
ACCESS_TOKEN_SECRET=<GENERATE: openssl rand -base64 48>
PORT=4000
RATE_LIMIT_TRUSTED_HOPS=1
# Edge rate limiting — unset/blank = OFF. RATE_LIMIT_MAX is the general per-IP budget per window;
# RATE_LIMIT_AUTH_MAX is the stricter cap applied to /auth/*. Both count requests per minute.
#RATE_LIMIT_MAX=120
#RATE_LIMIT_AUTH_MAX=20
OPERATOR_EMAILS=agora-admin@agora-oss.org,demo-admin@agora-oss.org
# Operators may also be listed by profile UUID (comma-separated). Same effect as OPERATOR_EMAILS —
# use whichever you have; set both and the union applies. Empty/unset = no id-based operators.
OPERATOR_USER_IDS=
# Accounts allowed a settings-read-only operator view (the shared public demo login): full operator
# visibility + the two non-destructive actions, but the five settings-save endpoints return 403.
# Comma-separated, case-insensitive emails. Empty/unset = feature off.
OPERATOR_RO_EMAILS=demo-admin@agora-oss.org
# Content deletion semantics (entities/comments/chat messages/events, deployment-wide):
#   hard (default) — truly DELETE the row (cascades: comment reply subtrees, an entity's comments)
#                    AND delete its media objects from MinIO/Supabase Storage (best-effort, async)
#   soft           — tombstone the row, hide it from reads, KEEP its media in storage (recoverable)
CONTENT_DELETE_MODE=hard

# ═══ DATA PLANE — local Postgres + MinIO (DEFAULT) ════════════════════════════
# The app runs on the HOST, so it reaches the dev compose's PUBLISHED containers at localhost. The
# scorer WORKER container can't use localhost (that's itself inside a container), so it reads
# DEV_DATABASE_URL at the in-network db address instead. The URL password MUST equal POSTGRES_PASSWORD.
DATABASE_URL=postgres://postgres:<POSTGRES_PASSWORD>@localhost:5432/postgres
DEV_DATABASE_URL=postgres://postgres:<POSTGRES_PASSWORD>@db:5432/postgres
STORAGE_PROVIDER=s3
S3_ENDPOINT=http://localhost:9000
S3_PUBLIC_URL=http://localhost/media
S3_ACCESS_KEY_ID=agora
S3_SECRET_ACCESS_KEY=<MINIO_ROOT_PASSWORD>
S3_BUCKET=agora
S3_REGION=us-east-1
S3_FORCE_PATH_STYLE=true
DEFAULT_AUTH_PROVIDER=native
# ── Native-auth email (Postmark) — SELF-HOSTED NATIVE AUTH ONLY ───────────────
# These apply ONLY to native (self-hosted) auth (DEFAULT_AUTH_PROVIDER=native, above): native auth
# gates sign-in on email confirmation and sends confirmation / password-reset / account-deletion mail
# via Postmark. If this deployment uses SUPABASE-HOSTED auth (DEFAULT_AUTH_PROVIDER=supabase), LEAVE
# THESE UNSET and configure those emails in the Supabase dashboard (Auth → Emails / SMTP) instead —
# Supabase Auth sends its own. On a dev box the log-only default is usually fine: without
# POSTMARK_SERVER_TOKEN the server just LOGS the confirm link (read it from the API logs). Set the token
# + a verified AUTH_EMAIL_FROM only if you want real delivery.
POSTMARK_SERVER_TOKEN=
AUTH_EMAIL_FROM=noreply@agora-oss.org
POSTMARK_MESSAGE_STREAM=outbound
AUTH_EMAIL_LINK_BASE=http://localhost:5173
# Allowlist of front-end origins a client may request via `emailRedirectTo`; a non-allowlisted value is
# rejected (400). REQUIRED for native-auth email — if unset, the confirm/reset/resend endpoints fail
# closed (503) rather than trust an unvalidated redirect. (Supabase-auth ignores this.)
AUTH_EMAIL_LINK_ALLOWED_ORIGINS=http://localhost,http://localhost:5175
POSTGRES_PASSWORD=<GENERATE: openssl rand -hex 16>
MINIO_ROOT_USER=agora
MINIO_ROOT_PASSWORD=<GENERATE: openssl rand -hex 16>
#
# ── OR cloud Supabase ─────────────────────────────────────────────────────────
# Comment the LOCAL block above (DATABASE_URL … MINIO_ROOT_PASSWORD; drop DEV_DATABASE_URL too — the
# cloud URL works from both host and container), uncomment these, and run `--profile supabase`:
#DATABASE_URL=postgresql://postgres.<PROJECT_REF>:<DB_PASSWORD>@aws-1-<region>.pooler.supabase.com:6543/postgres
#SUPABASE_URL=https://<PROJECT_REF>.supabase.co
#SUPABASE_ANON_KEY=<Supabase → Settings → API → anon / publishable>
#SUPABASE_SERVICE_ROLE_KEY=<Supabase → Settings → API → service_role (secret)>
#DEFAULT_AUTH_PROVIDER=supabase
# Only for a SELF-HOSTED GoTrue whose SUPABASE_URL is an internal shim (see .env.selfhost.example):
# the public origin swapped into browser-facing OAuth authorize URLs. Cloud Supabase: leave unset.
#SUPABASE_PUBLIC_AUTH_URL=
#
# ── SSO in dev (OPT-IN) — bundled GoTrue + social login ───────────────────────
# Dev defaults to NATIVE auth: zero infra, no GoTrue container. To exercise SSO locally instead,
# generate the key trio (`node apps/api/scripts/gen-gotrue-keys.mjs`) and uncomment this block, then
# `docker compose -f docker-compose.dev.yml --profile selfhost up -d` (brings up db + minio + gotrue
# + the Caddy front door). Topology differs from a container deploy: the api runs on your HOST, so it
# talks to GoTrue through the proxy's PUBLISHED shim on :9998, while the browser uses :80/auth/v1.
#DEFAULT_AUTH_PROVIDER=supabase
#SUPABASE_URL=http://localhost:9998
#SUPABASE_PUBLIC_AUTH_URL=http://localhost
#SUPABASE_ANON_KEY=<GENERATE: node apps/api/scripts/gen-gotrue-keys.mjs>
#SUPABASE_SERVICE_ROLE_KEY=<GENERATE: node apps/api/scripts/gen-gotrue-keys.mjs>
#GOTRUE_JWT_SECRET=<GENERATE: node apps/api/scripts/gen-gotrue-keys.mjs>
#GOTRUE_EXTERNAL_URL=http://localhost/auth/v1
#GOTRUE_SITE_URL=http://localhost:5175
#GOTRUE_URI_ALLOW_LIST=http://localhost:5175/*,http://localhost/*
# Origins the OAuth callback may hand tokens back to. Both admin origins in dev: the vite dev server
# (:5175) and the front door's baked admin (:80). Unset → falls back to PUBLIC_BASE_URL.
#OAUTH_REDIRECT_ALLOWED_ORIGINS=http://localhost:5175,http://localhost
# Which social buttons the ADMIN login screen renders (each must be enabled on gotrue below).
#AGORA_ADMIN_OAUTH_PROVIDERS=google,github
#GOTRUE_EXTERNAL_GOOGLE_ENABLED=true
#GOTRUE_EXTERNAL_GOOGLE_CLIENT_ID=<Google Cloud Console → OAuth client>
#GOTRUE_EXTERNAL_GOOGLE_SECRET=<Google OAuth client secret>
#GOTRUE_EXTERNAL_GITHUB_ENABLED=true
#GOTRUE_EXTERNAL_GITHUB_CLIENT_ID=<GitHub → Developer settings → OAuth Apps>
#GOTRUE_EXTERNAL_GITHUB_SECRET=<GitHub OAuth app secret>
# Cloud only: the scorer's NOTIFY listener needs a SESSION connection (LISTEN doesn't work over the
# :6543 transaction pooler) — point it at the :5432 session host. Local PG is already :5432, so skip this.
#SCORER_LISTEN_DATABASE_URL=postgresql://postgres.<PROJECT_REF>:<DB_PASSWORD>@aws-1-<region>.pooler.supabase.com:5432/postgres

# ═══ Front door (Caddy) ═══════════════════════════════════════════════════════
SERVER_NAME=:80
PUBLIC_BASE_URL=http://localhost
# The host API also reads this directly (moderation write-back target); on the host that's localhost.
API_BASE_URL=http://localhost:4000

# Origin of your PUBLIC consumer app — the community front end your users actually visit. The admin
# SPA uses it for the "Open in app" deep links on reports, AI flags, and steward cases.
# In THIS dev setup the admin runs on the host (`pnpm dev:admin`), so set it as a Vite var in
# apps/admin/.env instead:  VITE_PUBLIC_APP_URL=http://localhost:5174/
# On a containerized deploy the equivalent knob is AGORA_PUBLIC_APP_URL here (read at RUNTIME from the
# admin's /config.js) — see .env.selfhost.example / .env.prod.example.
# Unset → the links point at the local demo dev server (http://localhost:5174/), the dev default.

# ═══ Backing services — HOST-side hostnames (the app runs on the host) ════════
# The dev compose publishes these to localhost; it overrides the container-side consumers (scorer/cron)
# to service names automatically. Only needed if you add --profile scorer / --profile secure-chat.
NEO4J_URI=bolt://localhost:7687
NEO4J_AUTH=neo4j/<GENERATE: openssl rand -hex 16>
NEO4J_ACCEPT_LICENSE_AGREEMENT=yes
# Neo4j database name (multi-db installs). Default `neo4j`; leave commented unless yours differs.
#NEO4J_DATABASE=neo4j
# Redis — set ONLY with --profile secure-chat / scale / full (else the API logs redis warnings and
# falls back to in-memory). Uncomment when redis is up:
#REDIS_URL=redis://localhost:6379
# Cap on concurrently-open DB connection pools in the core registry (default 50). Generic
# tuning only — a single-DATABASE_URL deployment never approaches it. Leave commented.
#MAX_POOLS=50
# Optional deployment boot hook. A module specifier the server side-effect-imports ONCE at startup,
# before serving (e.g. to register a per-project DB resolver in a hosted deployment). Unset → no-op.
# If set and the module fails to load, the server refuses to start (fails closed). Hosting-layer knob;
# leave unset for a normal single-project deploy.
#AGORA_BOOT_MODULE=

# ═══ Internal endpoints (cron + scorer write-back) ════════════════════════════
CRON_SECRET=<GENERATE: openssl rand -base64 48>
MODERATION_SERVICE_SECRET=<GENERATE: openssl rand -base64 48>
# Scorer auto-action thresholds (block / human-review gray zone).
MODERATION_BLOCK_AUTO_ACTION_THRESHOLD=0.50
MODERATION_REVIEW_AUTO_ACTION_THRESHOLD=0.75

# ═══ Optional AI features (blank = disabled) ══════════════════════════════════
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5-20251001
ANTHROPIC_MAX_TOKENS=64000
VOYAGE_API_KEY=

# ═══ Integration tests (pnpm test:integration) ════════════════════════════════
# A DEDICATED, disposable Postgres (NOT your dev db) — the suite wipes + rebuilds it (isolated by
# project_id). A separate cloud Supabase "test" project is the usual choice; `genesis --test` rebuilds it.
# TEST_DATABASE_URL=postgresql://postgres.<TEST_REF>:<pw>@aws-1-<region>.pooler.supabase.com:6543/postgres
# TEST_NEO4J_URI=bolt://localhost:7687
# TEST_NEO4J_AUTH=neo4j/<password>

# ═══ Observability (off by default) ═══════════════════════════════════════════
LOG_LEVEL=debug
LOG_CONSOLE=aligned
OTEL_SDK_DISABLED=true

# ═══ Web push notifications (blank = dispatch is a no-op) ═════════════════════
# Generate a keypair once: `npx web-push generate-vapid-keys`. All three are required for push to
# work; with any unset the device registry still accepts registrations but no send is attempted.
# VAPID_SUBJECT must be a mailto: or https: URL identifying you to the push service.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:<you@your.domain>

# === Admin SPA — RUNTIME config (the dev compose's proxy rewrites /config.js on start) =========
# Only needed when you run the admin THROUGH the dev compose's proxy. Running it on the host
# (`pnpm dev:admin`) reads apps/admin/.env's VITE_* vars instead; these override those at runtime.
# Precedence is always: /config.js -> VITE_* -> built-in default.
#AGORA_PUBLIC_APP_URL=http://localhost:5174/   # public consumer app, for the admin's deep links
#AGORA_ADMIN_PROJECT_ID=<uuid>            # which project the admin manages (default: the seed project)
#AGORA_ADMIN_API_BASE_URL=/v7             # default: same-origin through the front door
#AGORA_ADMIN_MODERATOR_BASE_URL=/moderator
#AGORA_ADMIN_SOCIAL_GRAPH_ENABLED=true    # show the Social tab — needs NEO4J_URI set above
# UI guard ONLY, not a security boundary: it disables the Save buttons but the API still authorizes by
# token. Real enforcement is OPERATOR_RO_EMAILS on the API. Set both or neither.
#AGORA_ADMIN_SETTINGS_READ_ONLY=true
# One-click demo login on the admin's sign-in screen. WARNING: PUBLIC — served to every visitor in
# /config.js, as any browser-side prefill must be. Point at the shared demo account (the one you list
# in OPERATOR_RO_EMAILS), NEVER a real operator account.
#AGORA_ADMIN_DEMO_EMAIL=demo-admin@agora-oss.org
#AGORA_ADMIN_DEMO_PASSWORD=DemoAdmin123!
# Optional Umami analytics for the admin app — set BOTH or tracking stays off. Browser-side only:
# the admin loads Umami's script and posts events straight to your Umami instance; the API has no
# analytics code and never sees them. URL may carry a path prefix; the id is the ADMIN site's uuid.
#AGORA_ADMIN_UMAMI_URL=https://umami.example.com
#AGORA_ADMIN_UMAMI_ID=00000000-0000-0000-0000-000000000000

# === Demo (--profile demo — the pulled agora-demo harness, served at /demo/) ===
# The dev compose's demo service takes only this one knob (it's browser-facing and goes through
# Caddy to the host API). Override for a non-localhost front door.
#AGORA_DEMO_API_BASE_URL=http://localhost/v7
