# ──────────────────────────────────────────────────────────────────────────────
# Agora — SELFHOST config, pairs with docker-compose.yml (build the images from source).
# The API runs IN A CONTAINER. Agora is LOCAL-POSTGRES-FIRST: this template is configured for a
# local Postgres (the supabase/postgres image) + MinIO out of the box — NO cloud account needed.
# Cloud Supabase is an in-file switch (see the DATA PLANE block below).
#
# 1. cp .env.selfhost.example .env    2. fill every <GENERATE: …> placeholder
#
# ── Bring it up — local Postgres (the default) ────────────────────────────────
#     docker compose --profile selfhost up --build -d
#     docker compose exec agora node scripts/genesis.mjs --force      # schema + fixtures (LOCAL db)
#     docker compose exec -it agora node scripts/seeds/seed.mjs       # demo content + admin login
#   Admin SPA:  http://localhost      API:  http://localhost/v7       Media:  http://localhost/media
# ── Or cloud Supabase ─────────────────────────────────────────────────────────
#   Switch the DATA PLANE block below (comment LOCAL, uncomment CLOUD), then:
#     docker compose --profile supabase up --build -d
#
# Secret rules: passwords inside a URL / NEO4J_AUTH must avoid / @ : → openssl rand -hex 16 ·
#               token secrets are standalone (≥32 chars) → openssl rand -base64 48
# ──────────────────────────────────────────────────────────────────────────────
AGORA_ENV=selfhost

# ═══ Core ═════════════════════════════════════════════════════════════════════
# → openssl rand -base64 48   (HS256 signing secret; identical across agora + scorer + secure-chat)
ACCESS_TOKEN_SECRET=<GENERATE: openssl rand -base64 48>
PORT=4000
# One proxy hop (the bundled Caddy front door) → read the client IP one hop from the right of XFF.
RATE_LIMIT_TRUSTED_HOPS=1
# Edge rate limiting — unset/blank = OFF. RATE_LIMIT_MAX is the general per-IP budget per window;
# RATE_LIMIT_AUTH_MAX is the stricter cap applied to /auth/*. Both count requests per minute.
#RATE_LIMIT_MAX=120
#RATE_LIMIT_AUTH_MAX=20
# Make the seeded native admin a deployment operator (admin god-view). Matches the demo seed user.
OPERATOR_EMAILS=agora-admin@agora-oss.org,demo-admin@agora-oss.org
# Operators may also be listed by profile UUID (comma-separated). Same effect as OPERATOR_EMAILS —
# use whichever you have; set both and the union applies. Empty/unset = no id-based operators.
OPERATOR_USER_IDS=
# Accounts allowed a settings-read-only operator view (the shared public demo login): full operator
# visibility + the two non-destructive actions, but the five settings-save endpoints return 403.
# Comma-separated, case-insensitive emails. Empty/unset = feature off.
OPERATOR_RO_EMAILS=demo-admin@agora-oss.org
# Content deletion semantics (entities/comments/chat messages/events, deployment-wide):
#   hard (default) — truly DELETE the row (cascades: comment reply subtrees, an entity's comments)
#                    AND delete its media objects from MinIO/Supabase Storage (best-effort, async)
#   soft           — tombstone the row, hide it from reads, KEEP its media in storage (recoverable)
CONTENT_DELETE_MODE=hard

# ═══ DATA PLANE — local Postgres + MinIO (DEFAULT) ════════════════════════════
# In-container hostnames (compose service names). The "postgres" database is correct — the auth schema
# is per-database (see docs/SELF-HOSTING.md). The password here MUST equal POSTGRES_PASSWORD below.
DATABASE_URL=postgres://postgres:<POSTGRES_PASSWORD>@db:5432/postgres
STORAGE_PROVIDER=s3
S3_ENDPOINT=http://minio:9000
S3_PUBLIC_URL=http://localhost/media
S3_ACCESS_KEY_ID=agora
S3_SECRET_ACCESS_KEY=<MINIO_ROOT_PASSWORD>
S3_BUCKET=agora
S3_REGION=us-east-1
S3_FORCE_PATH_STYLE=true
# ── Auth: bundled GoTrue (Supabase Auth, self-hosted) — THE selfhost default ──
# The selfhost profile bundles GoTrue behind the Caddy front door: email+password AND social login
# (Google/GitHub/Apple) with no cloud dependency. SUPABASE_URL points at the proxy's INTERNAL GoTrue
# shim (server-side calls only — never expose :9998). Generate the key trio:
#   node apps/api/scripts/gen-gotrue-keys.mjs
DEFAULT_AUTH_PROVIDER=supabase
SUPABASE_URL=http://proxy:9998
# Public origin swapped into browser-facing OAuth authorize URLs (SUPABASE_URL is internal-only).
SUPABASE_PUBLIC_AUTH_URL=http://localhost
SUPABASE_ANON_KEY=<GENERATE: node apps/api/scripts/gen-gotrue-keys.mjs>
SUPABASE_SERVICE_ROLE_KEY=<GENERATE: node apps/api/scripts/gen-gotrue-keys.mjs>
GOTRUE_JWT_SECRET=<GENERATE: node apps/api/scripts/gen-gotrue-keys.mjs>
# Public base of GoTrue as browsers + OAuth providers see it: your origin + /auth/v1.
GOTRUE_EXTERNAL_URL=http://localhost/auth/v1
# Your front-end origin (where email links + OAuth flows land by default) + extra allowed redirect
# globs (comma-separated) — include every origin your apps redirect back to after sign-in.
GOTRUE_SITE_URL=http://localhost
GOTRUE_URI_ALLOW_LIST=http://localhost/*
# Email: EITHER real SMTP (below) OR autoconfirm (no emails; sign-ups confirm instantly and
# password-reset-by-email is unavailable — fine for trials, not for real communities).
GOTRUE_MAILER_AUTOCONFIRM=true
#GOTRUE_SMTP_HOST=smtp.example.org
#GOTRUE_SMTP_PORT=587
#GOTRUE_SMTP_USER=postmaster@example.org
#GOTRUE_SMTP_PASS=<smtp password>
#GOTRUE_SMTP_ADMIN_EMAIL=noreply@example.org
#GOTRUE_SMTP_SENDER_NAME=Agora
# ── Social login (all optional; docs/SELF-HOSTING.md has per-provider walkthroughs) ──
# Every provider's authorized redirect URI is: ${GOTRUE_EXTERNAL_URL}/callback
#GOTRUE_EXTERNAL_GOOGLE_ENABLED=true
#GOTRUE_EXTERNAL_GOOGLE_CLIENT_ID=<Google Cloud Console → OAuth client>
#GOTRUE_EXTERNAL_GOOGLE_SECRET=<Google OAuth client secret>
#GOTRUE_EXTERNAL_GITHUB_ENABLED=true
#GOTRUE_EXTERNAL_GITHUB_CLIENT_ID=<GitHub → Settings → Developer settings → OAuth Apps>
#GOTRUE_EXTERNAL_GITHUB_SECRET=<GitHub OAuth app secret>
#GOTRUE_EXTERNAL_APPLE_ENABLED=true
#GOTRUE_EXTERNAL_APPLE_CLIENT_ID=<Apple Services ID, e.g. org.example.agora.web>
# Apple's secret is a signed JWT that EXPIRES (≤180 days) — regenerate before expiry:
#   node apps/api/scripts/gen-apple-client-secret.mjs --key AuthKey_<KEYID>.p8 \
#     --team-id <TEAM> --client-id <SERVICES_ID> --key-id <KEYID>
#GOTRUE_EXTERNAL_APPLE_SECRET=<GENERATE: gen-apple-client-secret.mjs>
#
# ── Auth alternative: NATIVE (Agora's own credential store; no GoTrue container) ──
# Uncomment this block (and comment the GoTrue block above) to run without GoTrue — email+password
# only, no social login. Native auth gates sign-in on email confirmation and sends confirmation /
# password-reset / account-deletion mail via Postmark. Without POSTMARK_SERVER_TOKEN the server only
# LOGS the confirm link (no mail delivered). AUTH_EMAIL_FROM must be a Postmark-verified sender;
# AUTH_EMAIL_LINK_BASE is your FRONT-END origin (emailed links point there);
# AUTH_EMAIL_LINK_ALLOWED_ORIGINS is the allowlist of origins a client may request via
# `emailRedirectTo` (non-allowlisted → 400; unset → confirm/reset/resend fail closed 503).
#DEFAULT_AUTH_PROVIDER=native
#POSTMARK_SERVER_TOKEN=
#AUTH_EMAIL_FROM=noreply@agora-oss.org
#POSTMARK_MESSAGE_STREAM=outbound
#AUTH_EMAIL_LINK_BASE=http://localhost:5173
#AUTH_EMAIL_LINK_ALLOWED_ORIGINS=http://localhost,http://localhost:5175
# Credentials for the local compose services (must match DATABASE_URL / S3_* above). → openssl rand -hex 16
POSTGRES_PASSWORD=<GENERATE: openssl rand -hex 16>
MINIO_ROOT_USER=agora
MINIO_ROOT_PASSWORD=<GENERATE: openssl rand -hex 16>
#
# ── OR cloud Supabase ─────────────────────────────────────────────────────────
# Comment the LOCAL block above (DATABASE_URL … MINIO_ROOT_PASSWORD) AND the bundled-GoTrue block
# (SUPABASE_URL … GOTRUE_*), uncomment these, and run `--profile supabase` (no db/minio/gotrue
# containers; Supabase Storage is used when STORAGE_PROVIDER is unset; cloud Supabase Auth brokers
# OAuth — configure providers in its dashboard):
#DATABASE_URL=postgresql://postgres.<PROJECT_REF>:<DB_PASSWORD>@aws-1-<region>.pooler.supabase.com:6543/postgres
#SUPABASE_URL=https://<PROJECT_REF>.supabase.co
#SUPABASE_ANON_KEY=<Supabase → Settings → API → anon / publishable>
#SUPABASE_SERVICE_ROLE_KEY=<Supabase → Settings → API → service_role (secret)>
#DEFAULT_AUTH_PROVIDER=supabase

# ═══ Front door (Caddy) ═══════════════════════════════════════════════════════
# ":80" = plain HTTP (smoothest local experience; http://localhost is a browser "secure context").
SERVER_NAME=:80
PUBLIC_BASE_URL=http://localhost

# Origin of your PUBLIC consumer app — the community front end your users actually visit. The admin
# SPA uses it to build the "Open in app" deep links on reports, AI flags, and steward cases (it appends
# ?entity=&comment=). Read at RUNTIME (the proxy writes it into the admin's /config.js at start), so
# changing it needs only a `docker compose up -d proxy`, not an image rebuild.
# Leave it unset and those links point at the local demo dev server (http://localhost:5174/).
AGORA_PUBLIC_APP_URL=http://localhost/demo/

# ── Admin SPA — the rest of its settings, same RUNTIME seam, ALL OPTIONAL ─────
# Unset = the image's built-in default, which is right for a normal single-project deploy. Set any of
# these to retarget a PULLED image with no rebuild (`docker compose up -d proxy` to apply).
#AGORA_ADMIN_PROJECT_ID=<uuid>            # which project the admin manages (default: the seed project)
#AGORA_ADMIN_API_BASE_URL=/v7             # default: same-origin through this front door
#AGORA_ADMIN_MODERATOR_BASE_URL=/moderator
#AGORA_ADMIN_SOCIAL_GRAPH_ENABLED=true    # show the Social tab — needs NEO4J_URI set above
# UI guard ONLY, not a security boundary: it disables the Save buttons but the API still authorizes by
# token. Real enforcement is OPERATOR_RO_EMAILS on the API. Set both or neither.
#AGORA_ADMIN_SETTINGS_READ_ONLY=true
# Optional Umami analytics for the admin app — set BOTH or tracking stays off. Browser-side only:
# the admin loads Umami's script and posts events straight to your Umami instance; the API has no
# analytics code and never sees them. URL may carry a path prefix; the id is the ADMIN site's uuid.
#AGORA_ADMIN_UMAMI_URL=https://umami.example.com
#AGORA_ADMIN_UMAMI_ID=00000000-0000-0000-0000-000000000000
# One-click demo login on the admin's sign-in screen. ⚠️ PUBLIC — served to every visitor in
# /config.js, as any browser-side prefill must be. Point at the shared demo account (the one you list
# in OPERATOR_RO_EMAILS), NEVER a real operator account.
#AGORA_ADMIN_DEMO_EMAIL=demo-admin@agora-oss.org
#AGORA_ADMIN_DEMO_PASSWORD=DemoAdmin123!

# ═══ Backing services (in-container hostnames) ════════════════════════════════
# NEO4J_AUTH is the single combined "user/password" cred (API + scorer + the neo4j container all read it).
NEO4J_URI=bolt://neo4j:7687
NEO4J_AUTH=neo4j/<GENERATE: openssl rand -hex 16>
NEO4J_ACCEPT_LICENSE_AGREEMENT=yes
# Neo4j database name (multi-db installs). Default `neo4j`; leave commented unless yours differs.
#NEO4J_DATABASE=neo4j
# Redis — set ONLY when running --profile secure-chat / scale / full (secure-chat needs it as its
# fail-closed suspension index; or as the cross-replica rate-limit store). Commented by default: plain
# selfhost/scorer has no redis container, and a set REDIS_URL just logs connection warnings and falls
# back to in-memory rate limiting. Uncomment when you bring redis up:
#REDIS_URL=redis://redis:6379
# Cap on concurrently-open DB connection pools in the core registry (default 50). Generic
# tuning only — a single-DATABASE_URL deployment never approaches it. Leave commented.
#MAX_POOLS=50
# Optional deployment boot hook. A module specifier the server side-effect-imports ONCE at startup,
# before serving (e.g. to register a per-project DB resolver in a hosted deployment). Unset → no-op.
# If set and the module fails to load, the server refuses to start (fails closed). Hosting-layer knob;
# leave unset for a normal single-project deploy.
#AGORA_BOOT_MODULE=

# ═══ Internal endpoints (cron + scorer write-back) ════════════════════════════
CRON_SECRET=<GENERATE: openssl rand -base64 48>
MODERATION_SERVICE_SECRET=<GENERATE: openssl rand -base64 48>
# Scorer auto-action thresholds (block / human-review gray zone).
MODERATION_BLOCK_AUTO_ACTION_THRESHOLD=0.50
MODERATION_REVIEW_AUTO_ACTION_THRESHOLD=0.75

# ═══ Optional AI features (blank = disabled) ══════════════════════════════════
# ANTHROPIC_API_KEY: blank → RoBERTa-only moderation. VOYAGE_API_KEY: blank → lexical search only.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5-20251001
ANTHROPIC_MAX_TOKENS=64000
VOYAGE_API_KEY=

# ═══ Integration tests (pnpm test:integration) ════════════════════════════════
# A DEDICATED, disposable Postgres (NOT your selfhost db) — the suite wipes + rebuilds it (isolated by
# project_id). A separate cloud Supabase "test" project is the usual choice; `genesis --test` rebuilds it.
# TEST_DATABASE_URL=postgresql://postgres.<TEST_REF>:<pw>@aws-1-<region>.pooler.supabase.com:6543/postgres
# TEST_NEO4J_URI=bolt://localhost:7687
# TEST_NEO4J_AUTH=neo4j/<password>

# ═══ Observability (off by default) ═══════════════════════════════════════════
LOG_LEVEL=info
LOG_CONSOLE=aligned
OTEL_SDK_DISABLED=true

# === Demo =====================================================================
AGORA_DEMO_API_BASE_URL=http://localhost/v7
AGORA_DEMO_EMAIL=agora-admin@agora-oss.org
AGORA_DEMO_PASSWORD=DemoPass123!
AGORA_DEMO_ADMIN_URL=http://localhost
AGORA_DEMO_UMAMI_URL=
AGORA_DEMO_UMAMI_ID=
# Verbose secure-chat logging in the demo's browser console. Leave blank unless debugging E2E chat.
AGORA_DEMO_SECURE_CHAT_DEBUG=

# ═══ Web push notifications (blank = dispatch is a no-op) ═════════════════════
# Generate a keypair once: `npx web-push generate-vapid-keys`. All three are required for push to
# work; with any unset the device registry still accepts registrations but no send is attempted.
# VAPID_SUBJECT must be a mailto: or https: URL identifying you to the push service.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:<you@your.domain>
