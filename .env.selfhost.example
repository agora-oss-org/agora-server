# ──────────────────────────────────────────────────────────────────────────────
# Agora — SELFHOST config #4: CONTAINER app (built from source) + LOCAL Postgres + MinIO (no Supabase).
#
# 1. cp .env.selfhost.example .env    2. fill in every <GENERATE: …> placeholder
#    (run the openssl command shown beside each one)
#    (compose reads ".env" for BOTH ${VAR} interpolation AND the services' env_file)
#
# Fully self-contained local stack (NO Supabase, NO external services required to BOOT):
#   selfhost → local Postgres (db) + MinIO (minio) + the API (agora + proxy + cron)
#   full     → scorer (toxicity + relationship + worker) + neo4j + secure-chat + redis
#
# ── Bring it up ───────────────────────────────────────────────────────────────
# Compose reads ".env" for BOTH ${VAR} interpolation AND the services' env_file (already copied above):
#     docker compose --profile selfhost up --build -d
#     docker compose exec agora node scripts/genesis.mjs --force        # schema + fixtures (LOCAL db)
#     docker compose exec -it agora node scripts/seeds/seed.mjs          # demo content + admin login (interactive)
# Admin SPA:  http://localhost      API:  http://localhost/v7      Media:  http://localhost/media
#
# ── Secret rules (so the placeholders below don't break parsing) ──────────────
#   • PASSWORDS that live inside a URL (DATABASE_URL) or the "user/password" NEO4J_AUTH must NOT contain
#     "/", "@", ":" — use hex:           openssl rand -hex 16
#   • TOKEN SECRETS are standalone values; length is what matters (≥32) — base64 is fine:
#                                          openssl rand -base64 48
# ──────────────────────────────────────────────────────────────────────────────
AGORA_ENV=selfhost

# ═══ Core (required) ══════════════════════════════════════════════════════════
# selfhost uses the local Postgres "db" (NOT the Supabase :6543 pooler). The "postgres" database is
# correct — the auth schema is per-database (see docs/SELF-HOSTING.md).
# The password here MUST equal POSTGRES_PASSWORD below.   →  openssl rand -hex 16
DATABASE_URL=postgres://postgres:<POSTGRES_PASSWORD>@db:5432/postgres
# →  openssl rand -base64 48   (HS256 signing secret; min 32 chars)
ACCESS_TOKEN_SECRET=<GENERATE: openssl rand -base64 48>

# ═══ API server ═══════════════════════════════════════════════════════════════
PORT=4000
# One proxy hop (the bundled Caddy front door) → read the client IP one hop from the right of XFF.
RATE_LIMIT_TRUSTED_HOPS=1
# Make the seeded native admin a deployment operator (admin god-view). Matches seed-native-admin.mjs.
OPERATOR_EMAILS=agora-admin@gmail.com

# ═══ Front door (Caddy) ═══════════════════════════════════════════════════════
# ":80" = plain HTTP, no ACME and no internal-CA cert friction — the smoothest local experience.
# Everything is served from http://localhost (a browser "secure context", so WebCrypto/secure-chat works).
SERVER_NAME=:80

# ═══ Self-hosted storage (MinIO, S3-compatible) + native auth ═════════════════
STORAGE_PROVIDER=s3
S3_ENDPOINT=http://minio:9000
S3_PUBLIC_URL=http://localhost/media
S3_ACCESS_KEY_ID=agora
# MUST equal MINIO_ROOT_PASSWORD below.   →  openssl rand -hex 16
S3_SECRET_ACCESS_KEY=<MINIO_ROOT_PASSWORD>
S3_BUCKET=agora
S3_REGION=us-east-1
S3_FORCE_PATH_STYLE=true
# New projects (scripts/genesis.mjs) get in-API password auth, no Supabase.
DEFAULT_AUTH_PROVIDER=native

# Credentials for the selfhost compose services — MUST match DATABASE_URL / S3_* above.
# →  openssl rand -hex 16
POSTGRES_PASSWORD=<GENERATE: openssl rand -hex 16>
MINIO_ROOT_USER=agora
# →  openssl rand -hex 16
MINIO_ROOT_PASSWORD=<GENERATE: openssl rand -hex 16>

# ═══ secure-chat (full) ═══════════════════════════════════════════════════════
# Redis is a HARD dependency of the secure-chat process (the fail-closed suspension index).
REDIS_URL=redis://redis:6379

# ═══ Internal endpoints (full → cron scheduler + scorer write-back) ═══════════
# Without these the cron + moderation-apply endpoints return 503.   →  openssl rand -base64 48
CRON_SECRET=<GENERATE: openssl rand -base64 48>
MODERATION_SERVICE_SECRET=<GENERATE: openssl rand -base64 48>

# ═══ Social graph — Neo4j / DozerDB (full → scorer writes + API reads) ════════
# NEO4J_AUTH is the SINGLE combined "user/password" credential — the only Neo4j cred var. It is read by
# the API, the scorer AND the neo4j container itself. In-container compose overrides NEO4J_URI to
# bolt://neo4j:7687 (NEO4J_URI_DOCKER); this value matches so /social/* reads are enabled.
NEO4J_URI=bolt://neo4j:7687
# Keep the "neo4j/" user prefix; password is hex (no "/").   →  openssl rand -hex 16
NEO4J_AUTH=neo4j/<GENERATE: openssl rand -hex 16>
NEO4J_ACCEPT_LICENSE_AGREEMENT=yes

# ═══ Moderation (scorer) — optional Claude Haiku escalation ═══════════════════
# Blank → RoBERTa-only scoring; borderline items go to the human AI-flag queue (no Anthropic calls).
# Set a key to enable Haiku adjudication of gray-zone content.
ANTHROPIC_API_KEY=

# ═══ Semantic search — Voyage embeddings (optional) ═══════════════════════════
# Blank → lexical (ILIKE) search only. Set a key to enable /search/content vector search.
VOYAGE_API_KEY=

# ═══ Observability ════════════════════════════════════════════════════════════
LOG_LEVEL=info
LOG_CONSOLE=aligned
OTEL_SDK_DISABLED=true
