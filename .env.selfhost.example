# ──────────────────────────────────────────────────────────────────────────────
# Agora — SELFHOST config, pairs with docker-compose.yml (build the images from source).
# The API runs IN A CONTAINER. Agora is LOCAL-POSTGRES-FIRST: this template is configured for a
# local Postgres (the supabase/postgres image) + MinIO out of the box — NO cloud account needed.
# Cloud Supabase is an in-file switch (see the DATA PLANE block below).
#
# 1. cp .env.selfhost.example .env    2. fill every <GENERATE: …> placeholder
#
# ── Bring it up — local Postgres (the default) ────────────────────────────────
#     docker compose --profile selfhost up --build -d
#     docker compose exec agora node scripts/genesis.mjs --force      # schema + fixtures (LOCAL db)
#     docker compose exec -it agora node scripts/seeds/seed.mjs       # demo content + admin login
#   Admin SPA:  http://localhost      API:  http://localhost/v7       Media:  http://localhost/media
# ── Or cloud Supabase ─────────────────────────────────────────────────────────
#   Switch the DATA PLANE block below (comment LOCAL, uncomment CLOUD), then:
#     docker compose --profile supabase up --build -d
#
# Secret rules: passwords inside a URL / NEO4J_AUTH must avoid / @ : → openssl rand -hex 16 ·
#               token secrets are standalone (≥32 chars) → openssl rand -base64 48
# ──────────────────────────────────────────────────────────────────────────────
AGORA_ENV=selfhost

# ═══ Core ═════════════════════════════════════════════════════════════════════
# → openssl rand -base64 48   (HS256 signing secret; identical across agora + scorer + secure-chat)
ACCESS_TOKEN_SECRET=<GENERATE: openssl rand -base64 48>
PORT=4000
# One proxy hop (the bundled Caddy front door) → read the client IP one hop from the right of XFF.
RATE_LIMIT_TRUSTED_HOPS=1
# Make the seeded native admin a deployment operator (admin god-view). Matches the demo seed user.
OPERATOR_EMAILS=agora-admin@gmail.com

# ═══ DATA PLANE — local Postgres + MinIO (DEFAULT) ════════════════════════════
# In-container hostnames (compose service names). The "postgres" database is correct — the auth schema
# is per-database (see docs/SELF-HOSTING.md). The password here MUST equal POSTGRES_PASSWORD below.
DATABASE_URL=postgres://postgres:<POSTGRES_PASSWORD>@db:5432/postgres
STORAGE_PROVIDER=s3
S3_ENDPOINT=http://minio:9000
S3_PUBLIC_URL=http://localhost/media
S3_ACCESS_KEY_ID=agora
S3_SECRET_ACCESS_KEY=<MINIO_ROOT_PASSWORD>
S3_BUCKET=agora
S3_REGION=us-east-1
S3_FORCE_PATH_STYLE=true
DEFAULT_AUTH_PROVIDER=native
# Credentials for the local compose services (must match DATABASE_URL / S3_* above). → openssl rand -hex 16
POSTGRES_PASSWORD=<GENERATE: openssl rand -hex 16>
MINIO_ROOT_USER=agora
MINIO_ROOT_PASSWORD=<GENERATE: openssl rand -hex 16>
#
# ── OR cloud Supabase ─────────────────────────────────────────────────────────
# Comment the LOCAL block above (DATABASE_URL … MINIO_ROOT_PASSWORD), uncomment these, and run
# `--profile supabase` (no db/minio containers; Supabase Storage is used when STORAGE_PROVIDER is unset):
#DATABASE_URL=postgresql://postgres.<PROJECT_REF>:<DB_PASSWORD>@aws-1-<region>.pooler.supabase.com:6543/postgres
#SUPABASE_URL=https://<PROJECT_REF>.supabase.co
#SUPABASE_ANON_KEY=<Supabase → Settings → API → anon / publishable>
#SUPABASE_SERVICE_ROLE_KEY=<Supabase → Settings → API → service_role (secret)>
#DEFAULT_AUTH_PROVIDER=supabase

# ═══ Front door (Caddy) ═══════════════════════════════════════════════════════
# ":80" = plain HTTP (smoothest local experience; http://localhost is a browser "secure context").
SERVER_NAME=:80
PUBLIC_BASE_URL=http://localhost

# ═══ Backing services (in-container hostnames) ════════════════════════════════
# NEO4J_AUTH is the single combined "user/password" cred (API + scorer + the neo4j container all read it).
NEO4J_URI=bolt://neo4j:7687
NEO4J_AUTH=neo4j/<GENERATE: openssl rand -hex 16>
NEO4J_ACCEPT_LICENSE_AGREEMENT=yes
# Redis — set ONLY when running --profile secure-chat / scale / full (secure-chat needs it as its
# fail-closed suspension index; or as the cross-replica rate-limit store). Commented by default: plain
# selfhost/scorer has no redis container, and a set REDIS_URL just logs connection warnings and falls
# back to in-memory rate limiting. Uncomment when you bring redis up:
#REDIS_URL=redis://redis:6379

# ═══ Internal endpoints (cron + scorer write-back) ════════════════════════════
CRON_SECRET=<GENERATE: openssl rand -base64 48>
MODERATION_SERVICE_SECRET=<GENERATE: openssl rand -base64 48>
# Scorer auto-action thresholds (block / human-review gray zone).
MODERATION_BLOCK_AUTO_ACTION_THRESHOLD=0.50
MODERATION_REVIEW_AUTO_ACTION_THRESHOLD=0.75

# ═══ Optional AI features (blank = disabled) ══════════════════════════════════
# ANTHROPIC_API_KEY: blank → RoBERTa-only moderation. VOYAGE_API_KEY: blank → lexical search only.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5-20251001
ANTHROPIC_MAX_TOKENS=64000
VOYAGE_API_KEY=

# ═══ Observability (off by default) ═══════════════════════════════════════════
LOG_LEVEL=info
LOG_CONSOLE=aligned
OTEL_SDK_DISABLED=true
