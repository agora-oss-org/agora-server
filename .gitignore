node_modules/
dist/
*.tsbuildinfo
.vite/
# Env files hold real secrets — ignore every variant; the *.example templates are the only ones tracked.
.env
.env.*
!.env.*.example
*.log
.DS_Store

# Neo4j — runtime data (Docker volume) and plugin jars (downloaded on setup, not tracked)
neo4j/data/
neo4j/plugins/*.jar

# TLS edge certs (deploy/proxy/Caddyfile.onion) — never commit private keys/certs
deploy/proxy/certs/*
!deploy/proxy/certs/.gitkeep
