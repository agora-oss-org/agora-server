# Agora scheduled maintenance — supercronic fires the secret-gated internal cron endpoints.
# AGORA_URL (internal app origin) + CRON_SECRET come from the container env (see docker-compose.yml).
# Each job is wrapped in `sh -c` so $VARS expand — supercronic runs commands directly, not via a shell.

# Hourly, on the hour: deliver any space digests due this hour (the endpoint applies the per-space
# schedule-hour gate, so most hours are a cheap no-op).
0 * * * * sh -c 'curl -fsS -m 30 -X POST -H "X-Cron-Secret: $CRON_SECRET" "$AGORA_URL/internal/cron/digests"'

# Every 15 minutes: recompute feed scores. Only meaningful for projects on stored-mode `decay`;
# for hot/top/query-time it is a cheap consistency pass (scores already refresh on vote).
*/15 * * * * sh -c 'curl -fsS -m 60 -X POST -H "X-Cron-Secret: $CRON_SECRET" "$AGORA_URL/internal/cron/recompute-scores"'

# Every 5 minutes: reconcile the Redis suspension index against the DB (atomic rebuild — catches new
# suspensions, lifts, AND endDate expiries). No-op without REDIS_URL. Bounds any write-through drift and
# keeps @agora/secure-chat's fail-closed enforcement fresh (it reads the same shared index).
*/5 * * * * sh -c 'curl -fsS -m 30 -X POST -H "X-Cron-Secret: $CRON_SECRET" "$AGORA_URL/internal/cron/sync-suspensions"'

# Weekly (Sunday 04:00 UTC): re-materialize the Constellation snapshot. The endpoint's ~6-week per-project
# epoch gate makes most runs a cheap no-op (and self-heals a missed week); the long timeout covers GDS
# Louvain over the whole graph. §12 keeps this deliberately slow ("seasonal", never per-load).
0 4 * * 0 sh -c 'curl -fsS -m 600 -X POST -H "X-Cron-Secret: $CRON_SECRET" "$AGORA_URL/internal/cron/social-constellation"'

# Weekly (Sunday 05:00 UTC): re-materialize the operator admin-analytics snapshots (influence/silos/
# engagement). Runs after the Constellation pass; the in-lib weekly per-report epoch gate makes most runs
# a no-op (and self-heals a missed week). The long timeout covers GDS PageRank/betweenness/Louvain over
# the whole graph. Operators can force an out-of-band recompute via POST /admin/social/recompute.
0 5 * * 0 sh -c 'curl -fsS -m 600 -X POST -H "X-Cron-Secret: $CRON_SECRET" "$AGORA_URL/internal/cron/social-analytics"'
