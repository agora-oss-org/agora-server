{
  "name": "@agora/api",
  "version": "0.8.0",
  "private": true,
  "type": "module",
  "description": "Replyke-compatible community backend API (Hono + Supabase + socket.io)",
  "license": "AGPL-3.0-only",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:cov": "vitest run --coverage",
    "test:integration": "vitest run -c vitest.integration.config.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:migrate:run": "node scripts/migrate.mjs",
    "db:studio": "drizzle-kit studio",
    "db:wipe": "node scripts/wipe.mjs",
    "db:drop": "node scripts/drop.mjs",
    "seed": "node scripts/seeds/seed.mjs"
  },
  "dependencies": {
    "@agora/contract": "workspace:*",
    "@hono/node-server": "^1.13.7",
    "@jenova-marie/wonder-logger": "^2.0.18",
    "@supabase/supabase-js": "^2.47.10",
    "dotenv": "^17.4.2",
    "drizzle-orm": "^0.45.2",
    "hono": "^4.6.14",
    "ioredis": "^5.4.1",
    "jose": "^5.9.6",
    "postgres": "^3.4.9",
    "sharp": "^0.34.5",
    "socket.io": "^4.8.1",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@agora/secure-chat-core": "workspace:*",
    "@types/node": "^22.10.2",
    "@vitest/coverage-v8": "^4.1.7",
    "drizzle-kit": "^0.31.10",
    "socket.io-client": "^4.8.3",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^4.1.7"
  }
}
