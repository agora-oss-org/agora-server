{
  "name": "@agora/api",
  "version": "0.16.2",
  "private": true,
  "type": "module",
  "description": "Replyke-compatible community backend API (Hono + Supabase + socket.io)",
  "license": "AGPL-3.0-only",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:cov": "vitest run --coverage",
    "test:integration": "vitest run -c vitest.integration.config.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:migrate:run": "node scripts/migrate.mjs",
    "db:studio": "drizzle-kit studio",
    "db:wipe": "node scripts/wipe.mjs",
    "db:drop": "node scripts/drop.mjs",
    "genesis": "node scripts/genesis.mjs",
    "genesis:test": "node scripts/genesis.mjs --test",
    "seed": "node scripts/seeds/seed.mjs",
    "perf:seed": "node perf/seed-perf-data.mjs",
    "perf:baseline": "node perf/run.mjs"
  },
  "dependencies": {
    "@agora-server/contract": "workspace:*",
    "@agora/core": "workspace:*",
    "@aws-sdk/client-s3": "^3.901.0",
    "@hono/node-server": "^1.19.14",
    "@jenova-marie/wonder-logger": "^2.0.18",
    "@node-rs/argon2": "^2.0.2",
    "@opentelemetry/api": "^1.9.0",
    "@socket.io/redis-adapter": "^8.3.0",
    "@supabase/supabase-js": "^2.107.0",
    "dotenv": "^17.4.2",
    "drizzle-orm": "^0.45.2",
    "hono": "^4.12.23",
    "ioredis": "^5.11.1",
    "jose": "^5.10.0",
    "neo4j-driver": "^6.1.0",
    "postgres": "^3.4.9",
    "sharp": "^0.34.5",
    "socket.io": "^4.8.3",
    "web-push": "^3.6.7",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^22.19.20",
    "@types/web-push": "^3.6.4",
    "@vitest/coverage-v8": "^4.1.8",
    "drizzle-kit": "^0.31.10",
    "socket.io-client": "^4.8.3",
    "tsx": "^4.22.4",
    "typescript": "^5.9.3",
    "vitest": "^4.1.8"
  }
}
