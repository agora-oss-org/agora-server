# Agora server configuration
PORT=4000

# Database — Drizzle owns DB access via a direct Postgres connection.
# Use the DIRECT/SESSION connection (port 5432), NOT the transaction pooler (6543),
# for migrations. Find it in Supabase dashboard → Project Settings → Database.
DATABASE_URL=postgres://postgres:PASSWORD@db.YOUR_REF.supabase.co:5432/postgres

# Supabase — Auth (passwords + confirmation/reset emails) + Storage. Realtime is socket.io.
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJ...        # service-role: admin auth ops (createUser, updateUserById)
SUPABASE_ANON_KEY=eyJ...                 # anon: user auth (signUp/signIn/resetPassword/verifyOtp/resend)
SUPABASE_JWT_SECRET=                     # optional: verifying Supabase-issued tokens (HS256)

# Agora-issued tokens (the Replyke contract: 30m access / 30d refresh, rotating)
ACCESS_TOKEN_TTL=1800                     # seconds (30 min)
REFRESH_TOKEN_TTL=2592000                 # seconds (30 days)
ACCESS_TOKEN_SECRET=change-me
REFRESH_TOKEN_GRACE_SECONDS=30            # racing-tabs reuse grace window

# CORS
CORS_ORIGIN=*

# Admin app deployment operators (god-view: all spaces/content/reports). Comma-separated profile
# UUIDs and/or emails; either set marks the identity `isOperator`. Unset → no operators.
OPERATOR_USER_IDS=
OPERATOR_EMAILS=

# Public origin (scheme + host) of THIS server, e.g. https://api.example.com. Required behind a
# TLS-terminating reverse proxy so OAuth callback URLs are built with the public https host instead
# of the internal http://<internal-host> the server actually receives. Falls back to
# X-Forwarded-Proto/Host, then the raw request origin, when unset.
PUBLIC_BASE_URL=

# Cron — shared secret for POST /internal/cron/digests (X-Cron-Secret). Optional: unset disables
# the endpoint (503); space digests can still be sent via scripts/send-digests.mjs.
CRON_SECRET=

# Embeddings — Voyage AI (https://docs.voyageai.com). Anthropic's recommended provider.
VOYAGE_API_KEY=pa-...
VOYAGE_MODEL=voyage-3.5
EMBEDDING_DIMENSIONS=1024        # must match the entity_embeddings vector(N) column
