# @agora/moderator configuration.
#
# The moderator shares the repo's ROOT .env with the API (apps/moderator/.env -> ../../.env, the same
# symlink pattern as apps/api). So these variables live alongside the API's in the single root .env;
# this file documents the moderator's slice. DATABASE_URL, ACCESS_TOKEN_SECRET and CORS_ORIGIN are
# shared with the API (see apps/api/.env.example) — the moderator reads the same values.

# The moderator's HTTP port. Named MODERATOR_PORT (not PORT) so it coexists with the API's PORT=4000
# in the shared root .env.
MODERATOR_PORT=4001

# The API's ORIGIN (no /v7), e.g. http://localhost:4000. The moderator POSTs auto-removals to
# {API_BASE_URL}/internal/moderation/apply. In docker-compose this is overridden to http://agora:4000.
API_BASE_URL=http://localhost:4000

# Shared secret gating the API's POST /internal/moderation/apply write-back. Must match the value the
# API sees (same root .env). Unset on either side disables auto-action (verdicts still queue for humans).
MODERATION_SERVICE_SECRET=change-me

# NOTE: the thresholds + every MODERATOR_LLM_* below are DEFAULTS. A project can override any of them
# from the admin (Settings → Moderator), stored in projects.moderator_config; an unset override falls
# back to the value here. So a single-project deploy can run on env alone.

# Auto-remove a "block" verdict at/above this confidence (0..1). 0 (or unset) = advisory only:
# blocks are not removed automatically, they route to the admin AI-flag queue.
MODERATION_BLOCK_AUTO_ACTION_THRESHOLD=0.85

# Auto-remove a "review" verdict at/above this confidence (0..1). Defaults to 0 (off): a "review"
# verdict means "route to a human", so auto-acting on it is opt-in. Raise it to also auto-remove
# high-confidence reviews. Note: the model's confidence on a review is its certainty the item NEEDS
# review — set this deliberately.
MODERATION_REVIEW_AUTO_ACTION_THRESHOLD=0

# ── Generic LLM provider ────────────────────────────────────────────────────
# openai    → OpenAI-compatible /chat/completions (OpenAI, Groq, Together, OpenRouter, Ollama, vLLM,
#             LM Studio … point MODERATOR_LLM_BASE_URL at the host)
# anthropic → Anthropic /v1/messages
MODERATOR_LLM_PROVIDER=openai
MODERATOR_LLM_BASE_URL=                         # blank → the provider's default host
MODERATOR_LLM_API_KEY=sk-...                    # the moderation model's key (its own; may reuse ANTHROPIC_API_KEY)
MODERATOR_LLM_MODEL=gpt-4o-mini                 # e.g. claude-haiku-4-5-20251001 for the anthropic provider
MODERATOR_LLM_MAX_TOKENS=512

# Observability (wonder-logger; configured in wonder-logger.yaml). Prometheus metrics on :9465.
# LOG_LEVEL=info                                 # trace|debug|info|warn|error|fatal|silent
# LOG_CONSOLE=aligned                            # aligned (dev) | json (prod; the Docker image sets json)
# OTEL_SDK_DISABLED=true                         # turn OpenTelemetry off entirely (no collector needed)
