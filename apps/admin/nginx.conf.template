# nginx config for the Agora admin SPA. Processed by nginx's envsubst entrypoint at container
# start: ${API_UPSTREAM} is substituted from the env; nginx's own $vars ($uri, $host, $request_uri,
# $api_upstream, …) are left alone (they aren't environment variables).
#
# Upstream is resolved LAZILY (resolver + variable proxy_pass) so the admin container starts even
# when the API isn't reachable yet, and picks it up once it is — instead of crashing on boot the way
# a literal `proxy_pass http://agora:4000` would when the name can't resolve at startup.
server {
    listen 80;
    server_name _;
    root /usr/share/nginx/html;
    index index.html;

    # Docker's embedded DNS — re-resolves the API hostname at request time.
    resolver 127.0.0.11 ipv6=off valid=30s;

    gzip on;
    gzip_types text/css application/javascript application/json image/svg+xml;

    # Hashed Vite assets are immutable — cache hard.
    location /assets/ {
        expires 1y;
        add_header Cache-Control "public, immutable";
        try_files $uri =404;
    }

    # Reverse-proxy the Agora API (same origin → no CORS, no build-time API URL).
    location /v7/ {
        set $api_upstream "${API_UPSTREAM}";
        proxy_pass $api_upstream$request_uri;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # Reverse-proxy the services/scorer service. Rewrite /moderator → /v1 so it lands on the
    # moderator's own /v1/:projectId/moderation/* routes (matches the vite dev proxy rewrite).
    location /moderator/ {
        set $moderator_upstream "${MODERATOR_UPSTREAM}";
        rewrite ^/moderator/(.*)$ /v1/$1 break;
        proxy_pass $moderator_upstream;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # socket.io (chat realtime) — needs the WebSocket upgrade headers.
    location /socket.io/ {
        set $api_upstream_ws "${API_UPSTREAM}";
        proxy_pass $api_upstream_ws$request_uri;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host $host;
    }

    # SPA fallback — client-side routing.
    location / {
        try_files $uri $uri/ /index.html;
    }
}
