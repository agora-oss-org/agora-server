# Base URL of the @agora/api server (Vite only exposes VITE_-prefixed vars to the client).
# Defaults to "/v7" (same-origin) — the vite dev server and the prod nginx image both proxy /v7 to
# the API, so you usually don't need to set this. Override for a cross-origin API.
# VITE_API_BASE_URL=/v7

# Dev-only: prefill the login form with the seeded demo user (apps/api/scripts/seed-demo-user.mjs).
# Leave unset in any real deployment.
# VITE_DEMO_EMAIL=agora-admin@gmail.com
# VITE_DEMO_PASSWORD=DemoPass123!

# Origin of your consumer app, for the moderation "Open in app" deep link (the app reads
# ?entity=&comment= off its URL). Defaults to the local demo dev server (http://localhost:5174/).
# VITE_DEMO_URL=https://demo.example.com/

# Base URL of the services/scorer service (AI moderation: the AI-flag queue + per-item analysis).
# Defaults to "/moderator" (same-origin) — the vite dev proxy and the prod nginx image both forward
# /moderator to the moderator service (stripping the prefix). Override for a cross-origin moderator.
# VITE_MODERATOR_BASE_URL=/moderator

# Set "true" to make the Settings page view-only — every Save control is disabled (and submits blocked)
# so you can deploy the admin for viewing/operation without allowing settings changes. UI guard only,
# NOT a security boundary: the API still authorizes writes by operator token. Default: editable.
# VITE_SETTINGS_READ_ONLY=true
