# ──────────────────────────────────────────────────────────────────────────────
# Agora — PROD config, pairs with docker-compose.prod.yml (PULLED images, real domain).
# The API runs IN A CONTAINER from the published image (pin with AGORA_TAG). The Caddy front door is the
# only public surface (80/443); backend ports stay internal.
#
# Agora is LOCAL-POSTGRES-FIRST: this template is configured for a self-hosted local Postgres + MinIO out
# of the box (production self-hosting, no cloud account). Cloud Supabase is an in-file switch (below).
#
# 1. cp .env.prod.example .env    2. fill every <GENERATE: …> and <your.domain> placeholder
#
# ── Bring it up — local Postgres (the default) ────────────────────────────────
#     AGORA_TAG=vX.Y.Z docker compose -f docker-compose.prod.yml --profile selfhost up -d
#     docker compose -f docker-compose.prod.yml run --rm agora node scripts/migrate.mjs   # first deploy
#     docker compose -f docker-compose.prod.yml run --rm -it agora \
#       node scripts/seeds/helpers/seed-native-auth-admin.mjs                              # first admin
# ── Or cloud Supabase ─────────────────────────────────────────────────────────
#   Switch the DATA PLANE block below, then use `--profile supabase` (no db/minio containers).
#
# Secret rules: passwords inside a URL / NEO4J_AUTH must avoid / @ : → openssl rand -hex 16 ·
#               token secrets are standalone (≥32 chars) → openssl rand -base64 48
# ──────────────────────────────────────────────────────────────────────────────
AGORA_ENV=prod

# ═══ Core ═════════════════════════════════════════════════════════════════════
ACCESS_TOKEN_SECRET=<GENERATE: openssl rand -base64 48>
PORT=4000
RATE_LIMIT_TRUSTED_HOPS=1
OPERATOR_EMAILS=<you@your.domain>

# ═══ DATA PLANE — local Postgres + MinIO (DEFAULT, self-hosted production) ═════
# In-container hostnames (compose service names). The URL password MUST equal POSTGRES_PASSWORD.
DATABASE_URL=postgres://postgres:<POSTGRES_PASSWORD>@db:5432/postgres
STORAGE_PROVIDER=s3
S3_ENDPOINT=http://minio:9000
S3_PUBLIC_URL=https://<your.domain>/media
S3_ACCESS_KEY_ID=agora
S3_SECRET_ACCESS_KEY=<MINIO_ROOT_PASSWORD>
S3_BUCKET=agora
S3_REGION=us-east-1
S3_FORCE_PATH_STYLE=true
DEFAULT_AUTH_PROVIDER=native
POSTGRES_PASSWORD=<GENERATE: openssl rand -hex 16>
MINIO_ROOT_USER=agora
MINIO_ROOT_PASSWORD=<GENERATE: openssl rand -hex 16>
#
# ── OR cloud Supabase (managed Postgres + Auth + Storage) ─────────────────────
# Comment the LOCAL block above (DATABASE_URL … MINIO_ROOT_PASSWORD), uncomment these, run `--profile supabase`:
#DATABASE_URL=postgresql://postgres.<PROJECT_REF>:<DB_PASSWORD>@aws-1-<region>.pooler.supabase.com:6543/postgres
#SUPABASE_URL=https://<PROJECT_REF>.supabase.co
#SUPABASE_ANON_KEY=<Supabase → Settings → API → anon / publishable>
#SUPABASE_SERVICE_ROLE_KEY=<Supabase → Settings → API → service_role (secret)>
#DEFAULT_AUTH_PROVIDER=supabase

# ═══ Front door (Caddy) — real domain, auto-HTTPS ═════════════════════════════
# DNS for <your.domain> must point at this host so ACME can validate on :80.
# Behind an external TLS terminator instead? Set SERVER_NAME=:80.
SERVER_NAME=<your.domain>
PUBLIC_BASE_URL=https://<your.domain>
CORS_ORIGIN=https://<your.domain>
ACME_CA=https://acme-v02.api.letsencrypt.org/directory

# ═══ Backing services (in-container hostnames) ════════════════════════════════
NEO4J_URI=bolt://neo4j:7687
NEO4J_AUTH=neo4j/<GENERATE: openssl rand -hex 16>
NEO4J_ACCEPT_LICENSE_AGREEMENT=yes
# Redis — set ONLY with --profile secure-chat / scale / full (else the API logs redis warnings and
# falls back to in-memory). Uncomment when redis is up:
#REDIS_URL=redis://redis:6379

# ═══ Internal endpoints (cron + scorer write-back) ════════════════════════════
CRON_SECRET=<GENERATE: openssl rand -base64 48>
MODERATION_SERVICE_SECRET=<GENERATE: openssl rand -base64 48>
# Scorer auto-action thresholds (block / human-review gray zone).
MODERATION_BLOCK_AUTO_ACTION_THRESHOLD=0.50
MODERATION_REVIEW_AUTO_ACTION_THRESHOLD=0.75

# ═══ Optional AI features (blank = disabled) ══════════════════════════════════
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5-20251001
ANTHROPIC_MAX_TOKENS=64000
VOYAGE_API_KEY=

# ═══ Observability (off by default) ═══════════════════════════════════════════
LOG_LEVEL=info
LOG_CONSOLE=json
OTEL_SDK_DISABLED=true
