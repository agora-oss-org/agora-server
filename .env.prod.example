# ──────────────────────────────────────────────────────────────────────────────
# Agora — PROD config, pairs with docker-compose.prod.yml (PULLED images, real domain).
# The API runs IN A CONTAINER from the published image (pin with AGORA_TAG). The Caddy front door is the
# only public surface (80/443); backend ports stay internal.
#
# Agora is LOCAL-POSTGRES-FIRST: this template is configured for a self-hosted local Postgres + MinIO out
# of the box (production self-hosting, no cloud account). Cloud Supabase is an in-file switch (below).
#
# 1. cp .env.prod.example .env    2. fill every <GENERATE: …> and <your.domain> placeholder
#
# ── Bring it up — local Postgres (the default) ────────────────────────────────
#     AGORA_TAG=vX.Y.Z docker compose -f docker-compose.prod.yml --profile selfhost up -d
#     docker compose -f docker-compose.prod.yml run --rm agora node scripts/migrate.mjs   # first deploy
#     docker compose -f docker-compose.prod.yml run --rm -it agora \
#       node scripts/seeds/helpers/seed-native-auth-admin.mjs                              # first admin
# ── Or cloud Supabase ─────────────────────────────────────────────────────────
#   Switch the DATA PLANE block below, then use `--profile supabase` (no db/minio containers).
#
# Secret rules: passwords inside a URL / NEO4J_AUTH must avoid / @ : → openssl rand -hex 16 ·
#               token secrets are standalone (≥32 chars) → openssl rand -base64 48
# ──────────────────────────────────────────────────────────────────────────────
AGORA_ENV=prod

# ═══ Core ═════════════════════════════════════════════════════════════════════
ACCESS_TOKEN_SECRET=<GENERATE: openssl rand -base64 48>
PORT=4000
RATE_LIMIT_TRUSTED_HOPS=1
OPERATOR_EMAILS=<you@your.domain>
# Settings-read-only operator accounts (e.g. a shared demo login). Comma-separated emails; empty = off.
OPERATOR_RO_EMAILS=
# Content deletion semantics (entities/comments/chat messages/events, deployment-wide):
#   hard (default) — truly DELETE the row (cascades: comment reply subtrees, an entity's comments)
#                    AND delete its media objects from MinIO/Supabase Storage (best-effort, async)
#   soft           — tombstone the row, hide it from reads, KEEP its media in storage (recoverable)
CONTENT_DELETE_MODE=hard

# ═══ DATA PLANE — local Postgres + MinIO (DEFAULT, self-hosted production) ═════
# In-container hostnames (compose service names). The URL password MUST equal POSTGRES_PASSWORD.
DATABASE_URL=postgres://postgres:<POSTGRES_PASSWORD>@db:5432/postgres
STORAGE_PROVIDER=s3
S3_ENDPOINT=http://minio:9000
S3_PUBLIC_URL=https://<your.domain>/media
S3_ACCESS_KEY_ID=agora
S3_SECRET_ACCESS_KEY=<MINIO_ROOT_PASSWORD>
S3_BUCKET=agora
S3_REGION=us-east-1
S3_FORCE_PATH_STYLE=true
# Proxy → MinIO upstream for the public /media route (defaults to the compose `minio` service).
# Override when MinIO lives elsewhere (external stack / swarm service name). MUST be a directly
# reachable container address — do NOT point it at another reverse proxy's public hostname: Caddy
# forwards the original client Host header, so an outer front door will match the wrong vhost and
# 308-redirect the request (images then render as the SPA's index.html with no console error).
MINIO_UPSTREAM=http://minio:9000
DEFAULT_AUTH_PROVIDER=native
# ── Native-auth email (Postmark) — SELF-HOSTED NATIVE AUTH ONLY ───────────────
# These apply ONLY to native (self-hosted) auth (DEFAULT_AUTH_PROVIDER=native, above): native auth
# gates sign-in on email confirmation and sends confirmation / password-reset / account-deletion mail
# via Postmark. If this deployment uses SUPABASE-HOSTED auth (DEFAULT_AUTH_PROVIDER=supabase), LEAVE
# THESE UNSET and configure those emails in the Supabase dashboard (Auth → Emails / SMTP) instead —
# Supabase Auth sends its own. REQUIRED in production for native auth: without POSTMARK_SERVER_TOKEN the
# server only LOGS the confirm link (no mail). AUTH_EMAIL_FROM must be a Postmark-verified sender;
# AUTH_EMAIL_LINK_BASE is your public FRONT-END origin (the emailed links point there — never localhost).
POSTMARK_SERVER_TOKEN=<Postmark → Servers → API Tokens>
AUTH_EMAIL_FROM=noreply@agora-oss.org
POSTMARK_MESSAGE_STREAM=outbound
AUTH_EMAIL_LINK_BASE=https://<your-app-domain>
# Allowlist of front-end origins a client may request via the sign-up/reset `emailRedirectTo` field
# (each site sends its own origin so users return where they signed up). A non-allowlisted
# emailRedirectTo is rejected (400). REQUIRED for native-auth email: if unset, the confirm/reset/resend
# endpoints fail closed (503) rather than trust an unvalidated redirect. (Supabase-auth ignores this.)
AUTH_EMAIL_LINK_ALLOWED_ORIGINS=https://<app-domain>,https://<other-front-end>
POSTGRES_PASSWORD=<GENERATE: openssl rand -hex 16>
MINIO_ROOT_USER=agora
MINIO_ROOT_PASSWORD=<GENERATE: openssl rand -hex 16>
#
# ── OR cloud Supabase (managed Postgres + Auth + Storage) ─────────────────────
# Comment the LOCAL block above (DATABASE_URL … MINIO_ROOT_PASSWORD), uncomment these, run `--profile supabase`:
#DATABASE_URL=postgresql://postgres.<PROJECT_REF>:<DB_PASSWORD>@aws-1-<region>.pooler.supabase.com:6543/postgres
#SUPABASE_URL=https://<PROJECT_REF>.supabase.co
#SUPABASE_ANON_KEY=<Supabase → Settings → API → anon / publishable>
#SUPABASE_SERVICE_ROLE_KEY=<Supabase → Settings → API → service_role (secret)>
#DEFAULT_AUTH_PROVIDER=supabase

# ═══ Front door (Caddy) — real domain, auto-HTTPS ═════════════════════════════
# DNS for <your.domain> must point at this host so ACME can validate on :80.
# Behind an external TLS terminator instead? Set SERVER_NAME=:80.
SERVER_NAME=<your.domain>
PUBLIC_BASE_URL=https://<your.domain>
CORS_ORIGIN=https://<your.domain>
ACME_CA=https://acme-v02.api.letsencrypt.org/directory

# ═══ Backing services (in-container hostnames) ════════════════════════════════
NEO4J_URI=bolt://neo4j:7687
NEO4J_AUTH=neo4j/<GENERATE: openssl rand -hex 16>
NEO4J_ACCEPT_LICENSE_AGREEMENT=yes
# Redis — set ONLY with --profile secure-chat / scale / full (else the API logs redis warnings and
# falls back to in-memory). Uncomment when redis is up:
#REDIS_URL=redis://redis:6379
# Cap on concurrently-open DB connection pools in the core registry (default 50). Generic
# tuning only — a single-DATABASE_URL deployment never approaches it. Leave commented.
#MAX_POOLS=50
# Optional deployment boot hook. A module specifier the server side-effect-imports ONCE at startup,
# before serving (e.g. to register a per-project DB resolver in a hosted deployment). Unset → no-op.
# If set and the module fails to load, the server refuses to start (fails closed). Hosting-layer knob;
# leave unset for a normal single-project deploy.
#AGORA_BOOT_MODULE=

# ═══ Internal endpoints (cron + scorer write-back) ════════════════════════════
CRON_SECRET=<GENERATE: openssl rand -base64 48>
MODERATION_SERVICE_SECRET=<GENERATE: openssl rand -base64 48>
# Scorer auto-action thresholds (block / human-review gray zone).
MODERATION_BLOCK_AUTO_ACTION_THRESHOLD=0.50
MODERATION_REVIEW_AUTO_ACTION_THRESHOLD=0.75

# ═══ Optional AI features (blank = disabled) ══════════════════════════════════
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5-20251001
ANTHROPIC_MAX_TOKENS=64000
VOYAGE_API_KEY=

# ═══ Observability (off by default) ═══════════════════════════════════════════
LOG_LEVEL=info
LOG_CONSOLE=json
OTEL_SDK_DISABLED=true
# Grafana (the `observability` profile) is served behind the front door at /grafana/. In prod it
# requires a login (anonymous is disabled) — CHANGE this password before exposing it publicly. Point
# GRAFANA_ROOT_URL at your real domain so Grafana's asset/redirect URLs carry the /grafana/ prefix.
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=please_change_me
GRAFANA_ROOT_URL=https://localhost/grafana/
