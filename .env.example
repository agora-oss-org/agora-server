# ──────────────────────────────────────────────────────────────────────────────
# Agora — root environment file (single source of truth)
#
# Copy to `.env` and fill in. This root `.env` is loaded via direnv (`dotenv`) and
# is symlinked from `apps/api/.env -> ../../.env`, so it configures BOTH:
#   • @agora/api       (the Hono backend)
#   • services/scorer  (the Python content-moderation subsystem — shares this file)
# and the `AGORA_UMAMI_*` block below is also read at build time by the admin's
# vite.config. The admin's own browser vars (VITE_*) live in apps/admin/.env
# (see apps/admin/.env.example) — NOT here.
#
# Empty string == unset everywhere (optional features stay off when blank).
# Only DATABASE_URL and ACCESS_TOKEN_SECRET are hard requirements.
# ──────────────────────────────────────────────────────────────────────────────

# ═══ Core (required) ══════════════════════════════════════════════════════════

# Supabase Postgres — the TRANSACTION POOLER (port 6543), prepare:false. Drizzle
# owns all DB access through this. The moderator shares the same URL.
DATABASE_URL=postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres

# HS256 secret Agora signs its own access tokens with (and the moderator verifies
# the admin's operator JWT with — must be identical across both). Use a long random
# string of AT LEAST 32 characters, e.g. `openssl rand -base64 48`.
ACCESS_TOKEN_SECRET=change-me-to-a-long-random-secret-min-32-chars

# Max accepted upload size in bytes (defense-in-depth behind the proxy body cap). Default 25 MiB.
# MAX_UPLOAD_BYTES=26214400

# Integration tests only (`pnpm test:integration`) — a SEPARATE, disposable
# Postgres (a dedicated cloud Supabase test project); the suite points the app's
# DATABASE_URL at it and isolates by project_id. Never your real DB.
# TEST_DATABASE_URL=postgresql://postgres.<test-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres
# Optional: a separate Neo4j instance for integration tests (social-graph suite). Unset → graph tests skip.
# TEST_NEO4J_URI=bolt://neo4j-test:7687
# TEST_NEO4J_AUTH=neo4j/please_change_me

# ═══ API server ═══════════════════════════════════════════════════════════════

PORT=4000
# CORS_ORIGIN=*
# AGPL §13 source offer (surfaced at GET /source, GET /health, and the X-Source-Code header).
# Defaults to the upstream repo. If you run a MODIFIED Agora, you MUST repoint this at your fork.
# AGORA_SOURCE_URL=https://github.com/your-org/your-agora-fork
# Public origin (scheme+host) when behind a TLS-terminating proxy; used to build
# absolute OAuth callback URLs. Falls back to X-Forwarded-Proto/Host when unset.
# PUBLIC_BASE_URL=https://api.example.com

# Token lifetimes (seconds) + refresh-rotation grace window.
# ACCESS_TOKEN_TTL=1800
# REFRESH_TOKEN_TTL=2592000
# REFRESH_TOKEN_GRACE_SECONDS=30

# Deployment-operator allowlist (admin god-view). Comma-separated profile UUIDs
# and/or case-insensitive emails. Unset → no operators (everyone space-scoped).
# OPERATOR_USER_IDS=
# OPERATOR_EMAILS=you@example.com

# Edge rate limiting. OFF unless a max is set.
# RATE_LIMIT_WINDOW_SECONDS=60
# RATE_LIMIT_MAX=120
# RATE_LIMIT_AUTH_MAX=20
# Trusted reverse proxies in front of the app. The client IP is read this many hops from the RIGHT of
# X-Forwarded-For (spoof-resistant). 1 = a single nginx/CDN edge; 2 = the bundled Caddy edge + admin.
# RATE_LIMIT_TRUSTED_HOPS=1
# OPTIONAL shared store so the cap holds across MULTIPLE api replicas (a single replica needs none).
# Unset = in-process limiting. The app fail-opens to in-memory if Redis is unreachable. Use a
# least-privilege ACL user (see apps/api/README.md → "Redis ACL").
# REDIS_URL=redis://agora-rl:CHANGE_ME@redis:6379

# ═══ TLS edge proxy (optional — docker compose --profile edge) ════════════════
# Bundled Caddy front door: automatic HTTPS (Let's Encrypt, auto-renewed; internal CA for localhost),
# HSTS + security headers + body cap + authoritative X-Forwarded-For → admin. See deploy/proxy/README.md.
# Set SERVER_NAME to your real domain (DNS → this host, ports 80+443 reachable) and
# RATE_LIMIT_TRUSTED_HOPS=2 (caddy + admin). Default localhost uses Caddy's internal CA for dev.
# SERVER_NAME=agora.example.com
# MAX_BODY_SIZE=25MB
# HTTP_PORT=80
# HTTPS_PORT=443

# ═══ Supabase Auth + Storage (optional — gate password auth & uploads) ════════
# The DB-backed server boots without these; set them to enable Supabase-backed
# identity (passwords/confirmation emails) and Storage uploads.
# SUPABASE_URL=https://<ref>.supabase.co
# SUPABASE_ANON_KEY=
# SUPABASE_SERVICE_ROLE_KEY=
# SUPABASE_JWT_SECRET=

# ═══ Internal endpoints (secret-gated; 503 until set) ═════════════════════════
# Shared secret for POST /internal/cron/* (digests, score recompute, token purge).
# CRON_SECRET=
# Shared secret for POST /internal/moderation/apply (the moderator's write-back).
# MUST match the moderator's MODERATION_SERVICE_SECRET below.
# MODERATION_SERVICE_SECRET=

# ═══ Semantic search — Voyage embeddings (optional) ═══════════════════════════
# VOYAGE_API_KEY=
# VOYAGE_MODEL=voyage-3.5
# EMBEDDING_DIMENSIONS=1024

# ═══ RAG /search/ask — Anthropic (optional) ══════════════════════════════════
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-sonnet-4-6
# ANTHROPIC_MAX_TOKENS=1024

# ═══ Umami analytics (optional) ═══════════════════════════════════════════════
# Off unless URL + the relevant website id are set. AGORA_UMAMI_URL may carry a
# path prefix (e.g. https://host/umami) to put all Umami routes under one mount —
# the prefix is preserved when building /script.js, /api/send and /api/websites/*.
# AGORA_UMAMI_URL=https://umami.example.com
# AGORA_UMAMI_SERVER_ID=<website-uuid for server-side product events>
# AGORA_UMAMI_ADMIN_ID=<website-uuid for the admin app>
# SERVER_HOSTNAME tags server-side event sends; ADMIN_HOSTNAME is informational (the browser tracker
# auto-reports window.location.hostname, so the admin host resolves itself when served from there).
# AGORA_UMAMI_SERVER_HOSTNAME=api.example.com
# AGORA_UMAMI_ADMIN_HOSTNAME=admin.example.com
# Collect path for server-side sends (default /api/send; remap if your mount does).
# AGORA_UMAMI_SEND_PATH=/api/send
#
# Reporting read-back for the admin Analytics page (operator-only, server-side):
#   • Self-hosted Umami (cloudMode:false): set USERNAME + PASSWORD (login → Bearer).
#   • Umami Cloud: set API_KEY instead (x-umami-api-key). Login creds win if both set.
# AGORA_UMAMI_USERNAME=
# AGORA_UMAMI_PASSWORD=
# AGORA_UMAMI_API_KEY=
# Reporting base when the API isn't reachable on AGORA_UMAMI_URL (e.g. hit the
# internal service inside a swarm). Falls back to AGORA_UMAMI_URL.
# AGORA_UMAMI_API_URL=http://apps_umami:3000

# ══════════════════════════════════════════════════════════════════════════════
# Content-moderation write-back + thresholds — consumed by services/scorer (shares this root .env)
# ══════════════════════════════════════════════════════════════════════════════

# The API's ORIGIN (no /v7) — the scorer POSTs write-backs to
# {API_BASE_URL}/internal/moderation/apply.
# API_BASE_URL=http://localhost:4000

# Auto-remove thresholds (0..1). block default 0.85; review default 0 (off — route
# "review" verdicts to the human AI-flag queue unless you opt in).
# MODERATION_BLOCK_AUTO_ACTION_THRESHOLD=0.85
# MODERATION_REVIEW_AUTO_ACTION_THRESHOLD=0

# ══════════════════════════════════════════════════════════════════════════════
# services/scorer (Python toxicity + relationship scoring — REPLACES @agora/moderator)
# ══════════════════════════════════════════════════════════════════════════════
# Reuses from above: DATABASE_URL, ACCESS_TOKEN_SECRET, API_BASE_URL,
# MODERATION_SERVICE_SECRET, MODERATION_BLOCK/REVIEW_AUTO_ACTION_THRESHOLD.
# Borderline content is adjudicated by Claude Haiku (ANTHROPIC_API_KEY); per-project LLM-provider
# overrides live in projects.moderator_config (admin Settings → Moderator), not env.
#
# IMPORTANT: DATABASE_URL is the Supabase transaction pooler (:6543, prepare:false); the Python
# client disables prepared statements (asyncpg statement_cache_size=0). Don't point it at a direct
# :5432 connection expecting prepared statements.

# RoBERTa model servers (same image, different model + port; warm in RAM, CPU-pinned via compose).
# SCORER_TOXICITY_MODEL=s-nlp/roberta_toxicity_classifier
# SCORER_RELATIONSHIP_MODEL=cardiffnlp/twitter-roberta-base-sentiment-latest
# SCORER_TOXICITY_URL=http://scorer-toxicity:8001       # worker → model server (compose DNS)
# SCORER_RELATIONSHIP_URL=http://scorer-relationship:8002
# SCORER_ADMIN_PORT=4001                                 # worker serves /v1/*/moderation/* here

# Cascade gray-zone: toxicity in [low, high] escalates to Haiku; below low → allow, above high → block.
# SCORER_GRAYZONE_LOW=0.30
# SCORER_GRAYZONE_HIGH=0.80

# Haiku escalation (Anthropic). Unset ANTHROPIC_API_KEY → escalation OFF (record the RoBERTa score
# and route borderline items to the human AI-flag queue).
# ANTHROPIC_API_KEY=
# SCORER_HAIKU_MODEL=claude-haiku-4-5
# SCORER_HAIKU_MAX_TOKENS=512

# pgmq transport (the queue + enqueue trigger are created by migration 0027_scorer_pgmq_enqueue).
# SCORER_QUEUE=scorer_jobs
# SCORER_POLL_INTERVAL_MS=1000
# SCORER_VISIBILITY_TIMEOUT_S=60                         # at-least-once redelivery window
# Optional LISTEN/NOTIFY wake-up (migration 0033): the trigger pg_notify()s so the worker drains
# instantly instead of waiting for the next poll. MUST be a DIRECT/session DSN (:5432) — LISTEN does
# NOT work over the transaction pooler (:6543). Unset → poll-only (no wake-up).
# SCORER_LISTEN_DATABASE_URL=postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres

# Neo4j / DozerDB social graph. The scorer WRITES edges (unset → edge writes are no-ops); the API
# READS them for Garden surfaces like GET /social/weather (unset → those endpoints return 503).
# Both sides use the same three vars. See docs/SOCIAL-GRAPH.md.
# NEO4J_URI=bolt://neo4j:7687
# NEO4J_AUTH=neo4j/please_change_me    # "user/password" — same format Neo4j uses for NEO4J_AUTH
#
# Neo4j / DozerDB instance configuration (passed to the neo4j container via env_file).
# Required for APOC procedures used by the social-graph Cypher queries:
# NEO4J_initial_dbms_default__database=neo4j
# NEO4J_ACCEPT_LICENSE_AGREEMENT=yes
# NEO4J_PLUGINS='["apoc"]'                         # APOC via auto-download; OpenGDS loaded from ./neo4j/plugins/
# NEO4J_apoc_export_file_enabled=true
# NEO4J_apoc_import_file_enabled=true
# NEO4J_dbms_security_procedures_unrestricted=gds.*,apoc.*
# NEO4J_dbms_security_procedures_allowlist=gds.*,apoc.*
#
# Memory tuning — adjust to your host's available RAM:
# NEO4J_server_memory_heap_initial__size=512m
# NEO4J_server_memory_heap_max__size=1024m
# NEO4J_server_memory_pagecache_size=256m
#
# Bolt TLS (production only — Bolt is enabled with TLS off by default in Neo4j 5.x):
# NEO4J_dbms_ssl_policy_bolt_enabled=true
# NEO4J_dbms_ssl_policy_bolt_base_directory=/ssl
# NEO4J_dbms_ssl_policy_bolt_private_key=private_key
# NEO4J_dbms_ssl_policy_bolt_public_certificate=public_crt
# NEO4J_dbms_ssl_policy_bolt_client_auth=NONE

# ══════════════════════════════════════════════════════════════════════════════
# Observability (optional) — logging + OpenTelemetry (wonder-logger.yaml)
# ══════════════════════════════════════════════════════════════════════════════
# LOG_LEVEL=info
# LOG_CONSOLE=aligned          # aligned | json
# OTEL_SDK_DISABLED=true       # leave true unless you run a collector
# OTEL_TRACES_ENDPOINT=
# OTEL_METRICS_ENDPOINT=
# OTEL_LOGS_ENDPOINT=
