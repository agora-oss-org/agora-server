{
  "name": "agora-monorepo",
  "version": "0.14.0",
  "private": true,
  "type": "module",
  "description": "Agora monorepo — Replyke-compatible backend API, shared contract, and admin frontend.",
  "license": "AGPL-3.0-only",
  "packageManager": "pnpm@10.14.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "test:integration": "pnpm --filter @agora/api test:integration",
    "test:integration:secure-chat": "pnpm --filter @agora/secure-chat test:integration",
    "dev:contract": "pnpm --filter @agora-server/contract dev",
    "dev:core": "pnpm --filter @agora/core dev",
    "dev:api": "pnpm --filter @agora/api dev",
    "dev:api:log": "LOG_LEVEL=trace pnpm dev:api 2>&1 | tee /tmp/agora-api.log",
    "dev:secure-chat": "pnpm --filter @agora/secure-chat dev",
    "dev:admin": "pnpm --filter @agora/admin dev",
    "contract:build": "pnpm --filter @agora-server/contract build",
    "core:build": "pnpm --filter @agora/core build",
    "db:clean:secure-chat": "pnpm --filter @agora/secure-chat db:clean:secure-chat",
    "db:migrate": "pnpm --filter @agora/api db:migrate:run",
    "db:generate": "pnpm --filter @agora/api db:generate",
    "genesis": "pnpm --filter @agora/api genesis",
    "genesis:test": "pnpm --filter @agora/api genesis:test",
    "seed": "pnpm --filter @agora/api seed",
    "seed:graph": "pnpm --filter @agora/api seed:graph"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "sharp",
      "esbuild"
    ]
  }
}
