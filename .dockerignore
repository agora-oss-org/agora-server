# Build context is the repo root. Keep it lean — the api Dockerfile only COPYs
# the root manifests, packages/contract, and apps/api.
**/node_modules
**/dist
**/.vite
**/*.tsbuildinfo
**/coverage
**/test
**/*.test.ts
**/vitest.config.ts
**/vitest.integration.config.ts
.env
.env.*
!**/.env.example
**/*.log
.git
.gitignore
.DS_Store

# Docs / assets not needed to build either app image (each Dockerfile copies only its own
# workspace + packages/contract, so the other app's source in-context is just unused).
docs
assets
db
*.md
.github
