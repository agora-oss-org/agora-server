# Agora server configuration
PORT=4000

# Supabase
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJ...        # service-role key — bypasses RLS, keep secret
SUPABASE_JWT_SECRET=                     # for verifying Supabase-issued access tokens (HS256)

# Agora-issued tokens (the Replyke contract: 30m access / 30d refresh, rotating)
ACCESS_TOKEN_TTL=1800                     # seconds (30 min)
REFRESH_TOKEN_TTL=2592000                 # seconds (30 days)
ACCESS_TOKEN_SECRET=change-me
REFRESH_TOKEN_GRACE_SECONDS=30            # racing-tabs reuse grace window

# CORS
CORS_ORIGIN=*
