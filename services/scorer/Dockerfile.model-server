# Shared RoBERTa model server (runs as both scorer-toxicity and scorer-relationship; the model is
# chosen by SCORER_MODEL / SCORER_MODEL_KIND env). Build context is the REPO ROOT (matches the api/
# admin images), so paths below are repo-relative.
#
# Multi-stage: a builder installs deps into a venv, the runtime stage copies only the venv + source.
#
# The CPU torch wheel is large (see the image-size note in docs/SCORER.md). The HF model is downloaded
# on first startup and kept warm in RAM; mount a HF cache (HF_HOME) volume to avoid re-downloading on
# container recreate.

FROM python:3.11-slim AS builder
# TARGETARCH is auto-populated by buildx (amd64 | arm64) — used to pick the right CPU torch wheel.
ARG TARGETARCH
WORKDIR /app
ENV PIP_NO_CACHE_DIR=1 PIP_DISABLE_PIP_VERSION_CHECK=1
RUN python -m venv /opt/venv
ENV PATH="/opt/venv/bin:$PATH"
# Deps before source for layer caching.
COPY services/scorer/requirements.txt ./requirements.txt
RUN pip install -r requirements.txt
# Model deps: CPU-only torch. On amd64 the pytorch CPU index avoids pulling the (huge) CUDA build; on
# arm64 Linux the CPU wheel ships on PyPI's DEFAULT index (the /whl/cpu index has no aarch64 wheels),
# so install from PyPI there. Then transformers from PyPI.
RUN if [ "$TARGETARCH" = "arm64" ]; then \
      pip install --no-cache-dir "torch>=2.2"; \
    else \
      pip install --no-cache-dir "torch>=2.2" --index-url https://download.pytorch.org/whl/cpu; \
    fi
RUN pip install --no-cache-dir "transformers>=4.40"
# Slim the venv: drop bytecode caches + torch's bundled test trees (never needed at runtime).
RUN find /opt/venv -depth -type d -name '__pycache__' -exec rm -rf {} + ; \
    find /opt/venv -depth -type d \( -name 'test' -o -name 'tests' \) -path '*/torch/*' -exec rm -rf {} + ; \
    rm -rf /root/.cache

FROM python:3.11-slim AS runtime
WORKDIR /app
ENV PATH="/opt/venv/bin:$PATH" PYTHONUNBUFFERED=1
COPY --from=builder /opt/venv /opt/venv
COPY services/scorer/model_server ./model_server
# The shared, dependency-light telemetry + JSON-logging bootstrap lives in the `scorer` package
# (scorer/telemetry.py + scorer/logging.py). model_server imports it so all scorer services emit the
# same OTel signals; nothing else in the package is imported at runtime.
COPY services/scorer/scorer ./scorer
# Non-root.
RUN useradd --create-home --uid 10001 scorer && chown -R scorer /app
# HF model cache — pre-create it owned by `scorer` so a fresh named volume mounted here (see
# docker-compose.yml) inherits that ownership and persists downloaded models across container recreate.
ENV HF_HOME=/home/scorer/.cache/huggingface
RUN mkdir -p "$HF_HOME" && chown -R scorer /home/scorer/.cache
USER scorer
EXPOSE 8001
HEALTHCHECK --interval=30s --timeout=5s --start-period=20s --retries=3 \
  CMD python -c "import os,urllib.request; urllib.request.urlopen(f\"http://127.0.0.1:{os.environ.get('SCORER_PORT','8001')}/health\").read()" || exit 1
CMD ["python", "-m", "model_server.main"]
