# Hoist zod to the root node_modules so TypeScript can resolve it from @agora-server/contract's emitted
# dist/*.d.ts (which `import { z } from "zod"`). Without this, tsc resolving zod from the contract's
# dist fails in isolated installs (e.g. the Docker `--filter` build) → schemas collapse to `any`.
public-hoist-pattern[]=zod

# @jenova-marie packages are on public npm, not private Forgejo registry
@jenova-marie:registry=https://registry.npmjs.org/
